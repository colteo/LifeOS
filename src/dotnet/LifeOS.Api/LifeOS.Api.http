@LifeOS.Api_HostAddress = http://localhost:5050
# Paste the accessToken returned by the Development sign-in request below.
@accessToken = <accessToken>

GET {{LifeOS.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

POST {{LifeOS.Api_HostAddress}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Main account",
  "type": "BankAccount",
  "currency": "EUR"
}

###

GET {{LifeOS.Api_HostAddress}}/api/accounts
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{LifeOS.Api_HostAddress}}/api/categories
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Benzina",
  "type": "Expense",
  "parentCategoryId": "<id of one of your parent categories>"
}

###

GET {{LifeOS.Api_HostAddress}}/api/categories
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{LifeOS.Api_HostAddress}}/api/transactions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "Expense",
  "amount": 18.50,
  "accountId": "<account id>",
  "sourceAccountId": null,
  "destinationAccountId": null,
  "categoryId": "<expense category id>",
  "occurredAtUtc": "2026-09-29T18:00:00Z",
  "note": "Aperitivo"
}

###

POST {{LifeOS.Api_HostAddress}}/api/transactions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "Transfer",
  "amount": 100.00,
  "accountId": null,
  "sourceAccountId": "<source account id>",
  "destinationAccountId": "<destination account id>",
  "categoryId": null,
  "occurredAtUtc": "2026-09-29T18:00:00Z",
  "note": "Move to savings"
}

###

# Local month boundaries converted to UTC by the client (here: September 2026 in Europe/Rome).
GET {{LifeOS.Api_HostAddress}}/api/transactions?fromUtc=2026-08-31T22:00:00Z&toUtc=2026-09-30T22:00:00Z
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Authentication (ADR-006). Requires User Secrets:
#   Authentication:LifeOS:SigningKey              Base64 of >= 32 random bytes
#   Authentication:DevelopmentSignIn:Enabled      true (Development only)
POST {{LifeOS.Api_HostAddress}}/api/auth/dev/sign-in
Content-Type: application/json

{
  "subject": "dev-user-1",
  "email": "dev-user-1@example.com",
  "displayName": "Dev User"
}

###

GET {{LifeOS.Api_HostAddress}}/api/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{LifeOS.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "<refreshToken>"
}

###

POST {{LifeOS.Api_HostAddress}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "<refreshToken>"
}

###

# Onboarding (ADR-006). Each step returns the same shape as GET /api/me.
POST {{LifeOS.Api_HostAddress}}/api/onboarding/finance-profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "defaultCurrency": "EUR"
}

###

POST {{LifeOS.Api_HostAddress}}/api/onboarding/complete
Authorization: Bearer {{accessToken}}

###

# Google sign-in (ADR-006) is started by the app in the system browser:
#   GET /api/auth/google/start?code_challenge=<S256>&redirect_uri=lifeos://auth
# The app then exchanges the one-time code from lifeos://auth?code=... here.
POST {{LifeOS.Api_HostAddress}}/api/auth/token
Content-Type: application/json

{
  "code": "<code>",
  "codeVerifier": "<PKCE verifier>"
}

###

# Opening balances and derived balances (ADR-007). Amount is signed; AsOfUtc is the exact instant.
PUT {{LifeOS.Api_HostAddress}}/api/accounts/<account id>/opening-balance
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "amount": 1250.00,
  "asOfUtc": "2026-09-30T16:00:00Z"
}

###

GET {{LifeOS.Api_HostAddress}}/api/accounts/balances
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Newest transactions for overviews (default 5, 1-20).
GET {{LifeOS.Api_HostAddress}}/api/transactions/recent?limit=5
Authorization: Bearer {{accessToken}}
Accept: application/json

###
