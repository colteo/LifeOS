@* The small set of line icons the LifeOS shell uses: 24×24, stroked with the current text color,
   so every icon is styled like the text around it. Decorative: the button or link carries the
   accessible name. *@

<svg class="lo-icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	@switch (Name)
	{
		case "eye":
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "eye-off":
            <path d="m3 3 18 18M9.5 5.3A12 12 0 0 1 12 5c6.5 0 10 7 10 7a19 19 0 0 1-3.2 4.2M6.2 6.2A19 19 0 0 0 2 12s3.5 7 10 7a12 12 0 0 0 5.8-1.5" />
            <path d="M10 10a3 3 0 0 0 4 4" />
            break;
        case "home":
			<path d="M3.5 10.5 12 3.5l8.5 7" />
			<path d="M5.5 9v10.5a1 1 0 0 0 1 1h3.5v-6h4v6h3.5a1 1 0 0 0 1-1V9" />
			break;

		case "wallet":
			<path d="M16.5 6.5V5a1.5 1.5 0 0 0-1.9-1.45L5 6.5" />
			<rect x="3.5" y="6.5" width="17" height="13.5" rx="3" />
			<path d="M16 13.25h1.5" />
			break;

		case "plus":
			<path d="M12 5v14M5 12h14" />
			break;

		case "transactions":
			<path d="M8.5 6.5h12M8.5 12h12M8.5 17.5h12" />
			<path d="M4 6.5h.01M4 12h.01M4 17.5h.01" stroke-width="2.6" />
			break;

		case "grid":
			<rect x="4" y="4" width="6.5" height="6.5" rx="1.8" />
			<rect x="13.5" y="4" width="6.5" height="6.5" rx="1.8" />
			<rect x="4" y="13.5" width="6.5" height="6.5" rx="1.8" />
			<rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.8" />
			break;

		case "gear":
			@* A conventional settings cog: eight flat teeth around a hub. *@
			<path d="M10.16 4.83 L10.72 2.49 L13.28 2.49 L13.84 4.83 L15.77 5.63 L17.82 4.37 L19.63 6.18 L18.37 8.23 L19.17 10.16 L21.51 10.72 L21.51 13.28 L19.17 13.84 L18.37 15.77 L19.63 17.82 L17.82 19.63 L15.77 18.37 L13.84 19.17 L13.28 21.51 L10.72 21.51 L10.16 19.17 L8.23 18.37 L6.18 19.63 L4.37 17.82 L5.63 15.77 L4.83 13.84 L2.49 13.28 L2.49 10.72 L4.83 10.16 L5.63 8.23 L4.37 6.18 L6.18 4.37 L8.23 5.63Z" />
			<circle cx="12" cy="12" r="3.2" />
			break;

		case "chevron-left":
			<path d="M14.5 5.5 8 12l6.5 6.5" />
			break;

		case "chevron-right":
			<path d="M9.5 5.5 16 12l-6.5 6.5" />
			break;

		case "more-vertical":
			<circle cx="12" cy="5.5" r="1.4" fill="currentColor" stroke="none" />
			<circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
			<circle cx="12" cy="18.5" r="1.4" fill="currentColor" stroke="none" />
			break;

		case "chart":
			<path d="M4 20h16" />
			<path d="M7.5 16.5v-5M12 16.5V6.5M16.5 16.5v-8" />
			break;

		case "finance":
			<path d="M3.5 9.5 12 4l8.5 5.5" />
			<path d="M6 10.5v7M10 10.5v7M14 10.5v7M18 10.5v7" />
			<path d="M3.5 20h17" />
			break;

		case "gym":
			<path d="M3.5 9.5v5M20.5 9.5v5" />
			<rect x="5.5" y="6.5" width="3" height="11" rx="1" />
			<rect x="15.5" y="6.5" width="3" height="11" rx="1" />
			<path d="M8.5 12h7" />
			break;

		case "nutrition":
			@* Fork and knife. *@
			<path d="M7 3.5v17M4.5 3.5v4.5a2.5 2.5 0 0 0 5 0V3.5" />
			<path d="M18 20.5v-17c-2.2 1.3-3.5 3.9-3.5 7.5v2.5H18" />
			break;

		case "chevron-up":
			<path d="M5.5 14.5 12 8l6.5 6.5" />
			break;

		case "chevron-down":
			<path d="M5.5 9.5 12 16l6.5-6.5" />
			break;

		case "check":
			<path d="m5 12.5 4.5 4.5L19 7.5" />
			break;

		case "close":
			<path d="M6 6l12 12M18 6 6 18" />
			break;

		case "history":
			<circle cx="12" cy="12" r="8.5" />
			<path d="M12 7.5V12l3 2" />
			break;

		case "journal":
			@* An open notebook. *@
			<path d="M12 6.5c-1.8-1.4-4.6-2-8-2v13c3.4 0 6.2.6 8 2 1.8-1.4 4.6-2 8-2v-13c-3.4 0-6.2.6-8 2Z" />
			<path d="M12 6.5v13" />
			break;
	}
</svg>

@code {
	// One of: home, wallet, plus, transactions, grid, gear, chevron-left, chevron-right,
	// chevron-up, chevron-down, more-vertical, chart, finance, gym, nutrition, check, close, history,
	// journal.
	[Parameter, EditorRequired]
	public string Name { get; set; } = default!;

	[Parameter]
	public int Size { get; set; } = 22;

	[Parameter]
	public double StrokeWidth { get; set; } = 1.9;
}
