@* The page title row: the h1 on the left and, on the right, either "< Back" (a normal link to the
   page's parent; browser history is untouched) or one contextual Action. The h1 is the target of
   FocusOnNavigate. *@

<div class="lo-page-header">
	<h1 class="lo-page-title">@Title</h1>
	@if (BackHref is not null)
	{
		<a href="@BackHref" class="lo-header-action">
			<AppIcon Name="chevron-left" Size="18" StrokeWidth="2.2" />
			Back
		</a>
	}
	else
	{
		@Action
	}
</div>

@code {
	[Parameter, EditorRequired]
	public string Title { get; set; } = default!;

	[Parameter]
	public string? BackHref { get; set; }

	// The page's one contextual action (e.g. Portfolio → Analytics), when it has no Back link.
	[Parameter]
	public RenderFragment? Action { get; set; }
}
