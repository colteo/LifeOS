@inject AuthService Auth
@inject NavigationManager Navigation

<div class="auth-screen">
	<h1>LifeOS</h1>
	<p class="text-muted">Sign in to continue.</p>

	<button class="btn btn-primary btn-lg" @onclick="SignInAsync" disabled="@_signingIn">
		@if (_signingIn)
		{
			<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
		}
		Continue with Google
	</button>

	@if (!_signingIn && Auth.Message is not null)
	{
		<p class="text-danger mt-3" role="alert">@Auth.Message</p>
	}
</div>

@code {
	private bool _signingIn;

	private async Task SignInAsync()
	{
		_signingIn = true;

		try
		{
			// A new sign-in always starts on Home, never on the route open before sign-out.
			// Onboarding still comes first: AuthGate shows it, whatever the route, until it is complete.
			if (await Auth.SignInWithGoogleAsync())
			{
				Navigation.NavigateTo("/", replace: true);
			}
		}
		finally
		{
			_signingIn = false;
		}
	}
}
