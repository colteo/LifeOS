@inject AuthService Auth

@* First-run onboarding, shown by AuthGate while the signed-in user is not Completed. It has no
   route of its own. The step follows User.OnboardingStatus (from /api/me or the last step's
   response); the API validates every step. *@

<div class="onboarding">
	<p class="text-muted mb-1">Set up LifeOS · Step @(IsFirstStep ? 1 : 2) of 2</p>

	@if (IsFirstStep)
	{
		<FinanceProfileStep />
	}
	else
	{
		<FirstAccountStep User="User" />
	}

	<button class="btn btn-link mt-4 px-0" @onclick="Auth.SignOutAsync">Sign out</button>
</div>

@code {
	[Parameter, EditorRequired]
	public MeResponse User { get; set; } = default!;

	private bool IsFirstStep => User.OnboardingStatus == "PendingFinanceProfile";
}
