@implements IDisposable
@inject AuthService Auth
@inject LifeOS.App.Services.Notifications.PendingNotificationNavigation PendingNotification
@inject NavigationManager Navigation

@* Decides what the user sees: sign-in, the onboarding placeholder, or the app itself.
   Client-side presentation only; the API authorizes every request on its own. *@

@switch (Auth.State)
{
	case AuthState.Restoring:
		<div class="lo-boot" role="status" aria-label="Restoring session">
			<h1>LifeOS</h1>
			<p>Your personal life, in one place.</p>
		</div>
		break;

	case AuthState.SignedOut:
		<SignIn />
		break;

	case AuthState.Unreachable:
		<div class="auth-screen">
			<h1>LifeOS</h1>
			<p class="text-danger" role="alert">@Auth.Message</p>
			<button class="btn btn-primary" @onclick="RetryAsync" disabled="@_busy">Retry</button>
			<button class="btn btn-link" @onclick="Auth.SignOutAsync" disabled="@_busy">Sign out</button>
		</div>
		break;

	case AuthState.Authenticated when !Auth.IsOnboardingComplete:
		<OnboardingFlow User="Auth.CurrentUser" />
		break;

	default:
		@ChildContent
		break;
}

@code {
	private bool _busy;

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	protected override async Task OnInitializedAsync()
	{
		Auth.StateChanged += OnStateChanged;
		PendingNotification.Changed += OnNotificationTapped;

		if (Auth.State == AuthState.Restoring)
		{
			await Auth.RestoreSessionAsync();
		}

		OpenPendingNotification();
	}

	// AUTO-001: a tapped notification opens its page only inside the signed-in, onboarded app; until
	// then it waits. Its data never authorizes anything: the page loads through the API as usual.
	private void OpenPendingNotification()
	{
		if (Auth.State != AuthState.Authenticated || !Auth.IsOnboardingComplete)
		{
			return;
		}

		if (PendingNotification.TryTake() is { } target
			&& LifeOS.App.Services.Notifications.NotificationTap.PathFor(target) is { } path)
		{
			Navigation.NavigateTo(path);
		}
	}

	private void OnNotificationTapped() => InvokeAsync(OpenPendingNotification);

	private async Task RetryAsync()
	{
		_busy = true;

		try
		{
			await Auth.RetryAsync();
		}
		finally
		{
			_busy = false;
		}
	}

	private void OnStateChanged() => InvokeAsync(() =>
	{
		StateHasChanged();
		OpenPendingNotification();
	});

	public void Dispose()
	{
		Auth.StateChanged -= OnStateChanged;
		PendingNotification.Changed -= OnNotificationTapped;
	}
}
