@inject AuthService Auth

@* Placeholder until the onboarding screens exist: an incomplete user does not see the Finance app. *@

<div class="auth-screen">
	<h1>Completa la configurazione iniziale</h1>

	@if (Auth.CurrentUser?.DisplayName is { } name)
	{
		<p>Ciao, @name.</p>
	}

	<p class="text-muted">La configurazione del tuo profilo sarà disponibile a breve.</p>

	<button class="btn btn-link" @onclick="Auth.SignOutAsync">Esci</button>
</div>
