@inject AuthService Auth
@inject AccountsApiClient AccountsApi
@inject OnboardingApiClient OnboardingApi

@* Step 2: first account, then completion.
   Never creates a second account: existing accounts are checked on entry, and again before a
   new attempt after a failed creation (whose response may have been lost after the server saved
   it). Once an account exists, only completion can be retried. *@

@switch (state)
{
	case StepState.Loading:
		<p><em>Loading...</em></p>
		break;

	case StepState.LoadFailed:
		<div class="alert alert-danger" role="alert">@string.Join(" ", errors)</div>
		<button class="btn btn-primary" @onclick="LoadAccountsAsync">Retry</button>
		break;

	case StepState.NeedsAccount:
		<h1 class="h3">Add your first account</h1>
		<p class="text-muted">Your starter categories are ready.</p>

		<EditForm Model="form" OnSubmit="CreateAccountAndCompleteAsync">
			<div class="mb-3">
				<label for="first-account-name" class="form-label">Name</label>
				<InputText id="first-account-name" class="form-control" @bind-Value="form.Name" />
			</div>

			<div class="mb-3">
				<label for="first-account-type" class="form-label">Type</label>
				<InputSelect id="first-account-type" class="form-select" @bind-Value="form.Type">
					@foreach (var accountType in AccountTypeOptions.All)
					{
						<option value="@accountType">@AccountTypeOptions.Label(accountType)</option>
					}
				</InputSelect>
			</div>

			<div class="mb-3">
				<label for="first-account-currency" class="form-label">Currency</label>
				<InputText id="first-account-currency" class="form-control" maxlength="3" autocapitalize="characters" @bind-Value="form.Currency" />
			</div>

			<CurrentBalanceFields Input="currentBalance" AccountType="@form.Type" IdPrefix="first-account" />

			@ErrorAlert

			<button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isBusy">
				@(isBusy ? "Creating..." : "Create account and continue")
			</button>
		</EditForm>
		break;

	case StepState.ReadyToComplete:
		<h1 class="h3">Almost done</h1>
		<p>@readyMessage</p>

		@ErrorAlert

		<button class="btn btn-primary btn-lg w-100" @onclick="CompleteAsync" disabled="@isBusy">
			@(isBusy ? "Completing..." : errors.Count > 0 ? "Retry" : "Complete setup")
		</button>
		break;
}

@code {
	private const string AlreadyConfigured = "Your first account is already set up.";
	private const string CreatedNotCompleted = "The account was created. Complete setup to continue.";

	[Parameter, EditorRequired]
	public MeResponse User { get; set; } = default!;

	private StepState state = StepState.Loading;
	private AccountForm form = new();
	private bool isBusy;
	private bool lastCreateFailed;
	private string readyMessage = AlreadyConfigured;

	// Optional "current balance" (ADR-007), shared with the Accounts page.
	private readonly CurrentBalanceInput currentBalance = new(DateTime.Now);
	private IReadOnlyList<string> errors = [];

	protected override async Task OnInitializedAsync()
	{
		form = new AccountForm { Currency = User.DefaultCurrency ?? "EUR" };

		await LoadAccountsAsync();
	}

	// On entry (and after a restart): an account from an earlier attempt means only completion is left.
	private async Task LoadAccountsAsync()
	{
		state = StepState.Loading;
		errors = [];

		var result = await AccountsApi.GetAccountsAsync();

		if (!result.IsSuccess)
		{
			errors = result.Errors;
			state = StepState.LoadFailed;
		}
		else if (result.Value!.Count > 0)
		{
			readyMessage = AlreadyConfigured;
			state = StepState.ReadyToComplete;
		}
		else
		{
			state = StepState.NeedsAccount;
		}
	}

	private async Task CreateAccountAndCompleteAsync()
	{
		if (isBusy)
		{
			return;
		}

		if (!currentBalance.TryBuildRequest(DateTimeOffset.UtcNow, TimeZoneInfo.Local, out var openingBalance, out var validationError))
		{
			errors = [validationError!];
			return;
		}

		isBusy = true;
		errors = [];

		try
		{
			// A previous creation failed: its response may have been lost after the server saved the
			// account. Check first instead of creating a second one. No automatic retries.
			if (lastCreateFailed)
			{
				var existing = await AccountsApi.GetAccountsAsync();

				if (!existing.IsSuccess)
				{
					errors = existing.Errors;
					return;
				}

				if (existing.Value!.Count > 0)
				{
					readyMessage = CreatedNotCompleted;
					state = StepState.ReadyToComplete;
					await CompleteCoreAsync();
					return;
				}
			}

			var created = await AccountsApi.CreateAccountAsync(
				new CreateAccountRequest(form.Name, form.Type, form.Currency.Trim(), openingBalance));

			if (!created.IsSuccess)
			{
				lastCreateFailed = true;
				errors = created.Errors;
				return;
			}

			// From here on the form cannot be sent again: only completion is retried.
			readyMessage = CreatedNotCompleted;
			state = StepState.ReadyToComplete;
			await CompleteCoreAsync();
		}
		finally
		{
			isBusy = false;
		}
	}

	private async Task CompleteAsync()
	{
		if (isBusy)
		{
			return;
		}

		isBusy = true;
		errors = [];

		try
		{
			await CompleteCoreAsync();
		}
		finally
		{
			isBusy = false;
		}
	}

	private async Task CompleteCoreAsync()
	{
		var result = await OnboardingApi.CompleteAsync();

		if (!result.IsSuccess)
		{
			errors = result.Errors;
		}
		else if (!Auth.SetCurrentUser(result.Value!))
		{
			errors = [AuthService.InvalidSessionMessage];
		}

		// On success AuthGate re-renders with Completed and shows the app.
	}

	private RenderFragment ErrorAlert => @<text>
		@if (errors.Count > 0)
		{
			<div class="alert alert-danger" role="alert">
				<ul class="mb-0">
					@foreach (var error in errors)
					{
						<li>@error</li>
					}
				</ul>
			</div>
		}
	</text>;

	private enum StepState
	{
		Loading,
		LoadFailed,
		NeedsAccount,
		ReadyToComplete
	}

	private sealed class AccountForm
	{
		public string Name { get; set; } = string.Empty;

		public string Type { get; set; } = AccountTypeOptions.Default;

		public string Currency { get; set; } = "EUR";
	}
}
