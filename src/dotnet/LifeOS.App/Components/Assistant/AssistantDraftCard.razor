@using System.Globalization

@* AI-007 F4: the conversation's draft, as the API returns it. Shows every field, what is missing and what blocks a
   confirmation; Edit changes the draft's own fields; Confirm records it only on this explicit tap and only when the
   API says it can; Cancel drops the draft. One action at a time: every button is disabled while one runs or while
   the assistant is answering (it may be changing this draft), so a double tap never confirms twice (the API is
   idempotent as well). AI-008: one card for every kind — a Finance draft shows amount, type, account, category and
   note with the user's own accounts and categories; a water draft its millilitres; a meal draft what was eaten and
   the meal type. Date, time, status, missing fields, issues and the actions are common. No Finance control is shown
   on another kind of draft. *@

@if (Flow.Operation is { } operation)
{
	var finance = AssistantDisplay.IsFinance(operation);
	var open = operation.Status is AssistantOperationStatuses.Collecting or AssistantOperationStatuses.AwaitingConfirmation;
	var busy = Flow.IsDraftLocked;

	<section id="assistant-draft" class="lo-card lo-card--padded assistant-draft" aria-label="Assistant draft" aria-live="polite">
		<div class="d-flex justify-content-between align-items-center mb-2">
			<h2 class="h6 fw-semibold mb-0">@AssistantDisplay.TitleText(operation)</h2>
			<span class="badge assistant-draft__status">@AssistantDisplay.StatusText(operation.Status)</span>
		</div>

		@if (editor is null && diaryEditor is null)
		{
			<dl class="assistant-draft__fields mb-0">
				@if (operation.Draft is { } draft && finance)
				{
					<dt>Amount</dt>
					<dd>@AssistantDisplay.AmountText(draft, CultureInfo.CurrentCulture)</dd>
					<dt>Account</dt>
					<dd>@AssistantDisplay.AccountText(draft.Account)</dd>
					<dt>Category</dt>
					<dd>@AssistantDisplay.CategoryText(draft.Category)</dd>
					<dt>Note</dt>
					<dd class="text-break">@(draft.Note ?? "—")</dd>
					<dt>Date</dt>
					<dd>@AssistantDisplay.DateText(draft)</dd>
				}
				else if (operation.Hydration is { } water)
				{
					<dt>Amount</dt>
					<dd>@AssistantDisplay.WaterText(water)</dd>
					<dt>Date</dt>
					<dd>@AssistantDisplay.DateText(water.Occurrence, water.OccurredOn, water.OccurredTime)</dd>
				}
				else if (operation.Meal is { } meal)
				{
					<dt>What</dt>
					<dd class="text-break">@(meal.Description ?? "—")</dd>
					<dt>Meal</dt>
					<dd>@AssistantDisplay.MealTypeText(meal.MealType)</dd>
					<dt>Date</dt>
					<dd>@AssistantDisplay.DateText(meal.Occurrence, meal.OccurredOn, meal.OccurredTime)</dd>
				}
			</dl>

			@if (open && operation.MissingFields.Count > 0)
			{
				<p class="lo-muted small mt-2 mb-0">@AssistantDisplay.MissingText(operation.MissingFields)</p>
			}

			@if (open)
			{
				@foreach (var issue in operation.Issues)
				{
					<div class="alert alert-warning small mt-2 mb-0" role="alert">@AssistantDisplay.IssueText(issue)</div>
				}
			}

			@if (operation is { Status: AssistantOperationStatuses.Executed, TransactionId: { } transactionId })
			{
				<a href="@($"finance/transactions/{transactionId}")" class="btn btn-outline-secondary w-100 mt-3">View transaction</a>
			}
			else if (operation is { Status: AssistantOperationStatuses.Executed, ResultId: not null } && !finance)
			{
				<a href="nutrition" class="btn btn-outline-secondary w-100 mt-3">View in Nutrition</a>
			}
		}
		else if (editor is not null)
		{
			var categoryOptions = editor.CategoryOptions(Categories);

			<div class="mt-2">
				<div class="lo-segmented mb-3" role="group" aria-label="Type">
					<button type="button" class="lo-segmented__option" aria-pressed="@(editor.Type == AssistantDraftEditor.ExpenseType ? "true" : "false")"
							@onclick="() => editor.ChangeType(AssistantDraftEditor.ExpenseType, Categories)">Expense</button>
					<button type="button" class="lo-segmented__option" aria-pressed="@(editor.Type == AssistantDraftEditor.IncomeType ? "true" : "false")"
							@onclick="() => editor.ChangeType(AssistantDraftEditor.IncomeType, Categories)">Income</button>
				</div>

				<div class="mb-3">
					<label for="assistant-amount" class="form-label">Amount</label>
					<input id="assistant-amount" class="form-control lo-amount-input" inputmode="decimal" autocomplete="off" placeholder="0,00"
						   @bind="editor.AmountText" />
				</div>

				<div class="mb-3">
					<label for="assistant-account" class="form-label">Account</label>
					<select id="assistant-account" class="form-select" @bind="editor.AccountId">
						<option value="">Select an account</option>
						@foreach (var account in Accounts)
						{
							<option value="@account.Id">@account.Name (@account.Currency)</option>
						}
					</select>
				</div>

				<div class="mb-3">
					<label for="assistant-category" class="form-label">Category</label>
					<select id="assistant-category" class="form-select" @bind="editor.CategoryId">
						<option value="">Select a category</option>
						@foreach (var node in categoryOptions.TopLevel)
						{
							<option value="@node.Category.Id">@node.Category.Name</option>
							@foreach (var child in node.Children)
							{
								<option value="@child.Id">↳ @child.Name</option>
							}
						}
						@foreach (var category in categoryOptions.Unlinked)
						{
							<option value="@category.Id">@category.Name</option>
						}
					</select>
				</div>

				<div class="mb-3">
					<label for="assistant-note" class="form-label">Note</label>
					<textarea id="assistant-note" class="form-control" rows="2" @bind="editor.Note"></textarea>
				</div>

				<div class="d-flex gap-2 mb-3">
					<div class="flex-fill">
						<label for="assistant-date" class="form-label">Date</label>
						<input id="assistant-date" type="date" class="form-control" value="@editor.OccurredOn"
							   @onchange="args => editor.OccurredOn = args.Value?.ToString() ?? string.Empty" />
					</div>
					<div class="flex-fill">
						<label for="assistant-time" class="form-label">Time</label>
						<input id="assistant-time" type="time" class="form-control" value="@editor.OccurredTime"
							   @onchange="args => editor.OccurredTime = args.Value?.ToString() ?? string.Empty" />
					</div>
				</div>

				@EditActions(busy)
			</div>
		}
		else if (diaryEditor is not null)
		{
			<div class="mt-2">
				@if (diaryEditor.IsWater)
				{
					<div class="mb-3">
						<label for="assistant-water" class="form-label">Amount (ml)</label>
						<input id="assistant-water" class="form-control" inputmode="numeric" autocomplete="off" placeholder="250"
							   @bind="diaryEditor.AmountMlText" />
					</div>
				}
				else
				{
					<div class="mb-3">
						<label for="assistant-meal" class="form-label">What did you eat?</label>
						<textarea id="assistant-meal" class="form-control" rows="2" @bind="diaryEditor.Description"></textarea>
					</div>

					<div class="mb-3">
						<label for="assistant-meal-type" class="form-label">Meal</label>
						<select id="assistant-meal-type" class="form-select" @bind="diaryEditor.MealType">
							<option value="">No meal type</option>
							@foreach (var mealType in AssistantDiaryDraftEditor.MealTypes)
							{
								<option value="@mealType">@AssistantDisplay.MealTypeText(mealType)</option>
							}
						</select>
					</div>
				}

				<div class="d-flex gap-2 mb-3">
					<div class="flex-fill">
						<label for="assistant-diary-date" class="form-label">Date</label>
						<input id="assistant-diary-date" type="date" class="form-control" value="@diaryEditor.OccurredOn"
							   @onchange="args => diaryEditor.OccurredOn = args.Value?.ToString() ?? string.Empty" />
					</div>
					<div class="flex-fill">
						<label for="assistant-diary-time" class="form-label">Time</label>
						<input id="assistant-diary-time" type="time" class="form-control" value="@diaryEditor.OccurredTime"
							   @onchange="args => diaryEditor.OccurredTime = args.Value?.ToString() ?? string.Empty" />
					</div>
				</div>

				@EditActions(busy)
			</div>
		}

		@if (Flow.OperationError is not null)
		{
			<div class="alert alert-danger small mt-3 mb-0" role="alert">@Flow.OperationError</div>
		}

		@if (Flow.OperationNotice is not null)
		{
			<div class="alert alert-success small mt-3 mb-0" role="status">@Flow.OperationNotice</div>
		}

		@if (open && editor is null && diaryEditor is null)
		{
			<div class="d-flex gap-2 mt-3">
				<button type="button" class="btn btn-primary flex-fill" @onclick="ConfirmAsync" disabled="@(busy || !operation.CanConfirm)">
					@(Flow.IsOperationBusy ? "Please wait..." : "Confirm")
				</button>
				<button type="button" class="btn btn-outline-secondary" @onclick="OpenEditor" disabled="@busy">Edit</button>
				<button type="button" class="btn btn-outline-danger" @onclick="CancelAsync" disabled="@busy">Cancel</button>
			</div>
		}
	</section>
}

@code {
	private AssistantDraftEditor? editor;
	private AssistantDiaryDraftEditor? diaryEditor;
	private string? editError;

	[Parameter, EditorRequired]
	public AssistantChatFlow Flow { get; set; } = default!;

	[Parameter, EditorRequired]
	public IReadOnlyList<AccountResponse> Accounts { get; set; } = [];

	[Parameter, EditorRequired]
	public IReadOnlyList<CategoryResponse> Categories { get; set; } = [];

	[Parameter, EditorRequired]
	public CancellationToken CancellationToken { get; set; }

	private RenderFragment EditActions(bool busy) => @<text>
		@if (editError is not null)
		{
			<div class="text-danger small mb-2" role="alert">@editError</div>
		}

		<div class="d-flex gap-2">
			<button type="button" class="btn btn-primary flex-fill" @onclick="SaveAsync" disabled="@busy">@(Flow.IsOperationBusy ? "Saving..." : "Save")</button>
			<button type="button" class="btn btn-outline-secondary flex-fill" @onclick="CloseEditor" disabled="@busy">Discard changes</button>
		</div>
	</text>;

	private void OpenEditor()
	{
		if (Flow.Operation is { } operation)
		{
			if (AssistantDisplay.IsFinance(operation))
			{
				editor = AssistantDraftEditor.From(operation);
			}
			else
			{
				diaryEditor = AssistantDiaryDraftEditor.From(operation);
			}
		}

		editError = null;
	}

	private void CloseEditor()
	{
		editor = null;
		diaryEditor = null;
		editError = null;
	}

	private async Task SaveAsync()
	{
		if (Flow.Operation is not { } operation || (editor is null && diaryEditor is null))
		{
			return;
		}

		var (request, error) = editor is not null ? editor.BuildPatch(operation.DraftVersion) : diaryEditor!.BuildPatch(operation.DraftVersion);
		editError = error;

		if (error is null && await Flow.SaveDraftAsync(request, CancellationToken))
		{
			CloseEditor();
		}
	}

	private Task ConfirmAsync() => Flow.ConfirmAsync(CancellationToken);

	private Task CancelAsync() => Flow.CancelAsync(CancellationToken);
}
