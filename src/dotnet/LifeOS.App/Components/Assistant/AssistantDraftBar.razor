@using System.Globalization

@* AI-007: the conversation's draft in one line, pinned under the header while the conversation scrolls, so its
   Confirm and Cancel stay at hand however long the conversation grows and while new messages are sent. Same flow
   and same rules as the draft card (which shows every field and Edit): Confirm only on this explicit tap and only
   when the API says it can; every action waits while another runs or the assistant is answering. A draft that has
   ended shows how (Recorded with its transaction, Cancelled, Expired) with no action left but Close. *@

@if (Flow.Operation is { } operation)
{
	var open = Flow.IsOperationOpen;
	var busy = Flow.IsDraftLocked;

	<section class="lo-card assistant-draft-bar" aria-label="Transaction draft summary">
		<div class="assistant-draft-bar__summary">
			<span class="fw-semibold text-truncate">
				@AssistantDisplay.TypeText(operation.Draft.Type) · @AssistantDisplay.AmountText(operation.Draft, CultureInfo.CurrentCulture)
			</span>
			<span class="badge assistant-draft-bar__status">@AssistantDisplay.StatusText(operation.Status)</span>
		</div>

		@if (open)
		{
			@if (operation.MissingFields.Count > 0)
			{
				<p class="lo-muted small mb-0">@AssistantDisplay.MissingText(operation.MissingFields)</p>
			}

			<div class="d-flex gap-2">
				<button type="button" class="btn btn-sm btn-primary flex-fill" @onclick="ConfirmAsync" disabled="@(busy || !operation.CanConfirm)">
					@(Flow.IsOperationBusy ? "Please wait..." : "Confirm")
				</button>
				<button type="button" class="btn btn-sm btn-outline-danger" @onclick="CancelAsync" disabled="@busy">Cancel</button>
			</div>
		}
		else
		{
			<div class="d-flex gap-2">
				@if (operation is { Status: AssistantOperationStatuses.Executed, TransactionId: { } transactionId })
				{
					<a href="@($"finance/transactions/{transactionId}")" class="btn btn-sm btn-outline-secondary flex-fill">View transaction</a>
				}
				<button type="button" class="btn btn-sm btn-link ms-auto" @onclick="Flow.DismissOperation" disabled="@busy">Close</button>
			</div>
		}
	</section>
}

@code {
	[Parameter, EditorRequired]
	public AssistantChatFlow Flow { get; set; } = default!;

	[Parameter, EditorRequired]
	public CancellationToken CancellationToken { get; set; }

	private Task ConfirmAsync() => Flow.ConfirmAsync(CancellationToken);

	private Task CancelAsync() => Flow.CancelAsync(CancellationToken);
}
