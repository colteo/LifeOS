@* REM-001 §4.1 list rows: "08:30 · Every day" under the title, then the next occurrence (or the last
   outcome). Each row is one link with one readable announcement. *@

<ul class="lo-card lo-list">
	@foreach (var item in Items)
	{
		<li>
			<a href="@($"reminders/{item.Id}")" class="lo-row lo-row--center" aria-label="@ReminderDisplay.RowLabel(item, Today)">
				<span class="lo-row__icon"><AppIcon Name="reminders" /></span>
				<span class="lo-row__main">
					<span class="lo-row__title d-block text-break">@item.Label</span>
					<span class="lo-row__sub d-block">@ReminderDisplay.ScheduleText(item.Schedule, Today)</span>
					@if (ReminderDisplay.NextText(item, Today) is { } next)
					{
						<span class="lo-row__sub d-block">@next</span>
					}
					else if (ReminderDisplay.LastText(item, Today, TimeZoneInfo.Local) is { } last)
					{
						<span class="lo-row__sub d-block">@last</span>
					}
					@if (ReminderDisplay.SnoozeText(item, Today, TimeZoneInfo.Local) is { } snoozed)
					{
						<span class="lo-row__sub d-block">@snoozed</span>
					}
				</span>
				<span class="lo-row__chevron"><AppIcon Name="chevron-right" Size="18" /></span>
			</a>
		</li>
	}
</ul>

@code {
	[Parameter, EditorRequired]
	public IReadOnlyList<ReminderResponse> Items { get; set; } = [];

	[Parameter, EditorRequired]
	public DateOnly Today { get; set; }
}
