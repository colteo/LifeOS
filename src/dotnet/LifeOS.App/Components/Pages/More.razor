@page "/more"

@* The LifeOS module directory. It lists only modules that exist: each new module adds one entry
   here when it ships. Settings is not a module; it is reached from the header. *@

<PageHeader Title="Modules" />

<div class="lo-card">
	<ul class="lo-list">
		@foreach (var module in Modules)
		{
			<li>
				<a href="@module.Href" class="lo-row lo-row--center">
					<span class="lo-row__icon"><AppIcon Name="@module.Icon" /></span>
					<span class="lo-row__main">
						<span class="lo-row__title d-block">@module.Name</span>
						<span class="lo-row__sub d-block">@module.Description</span>
					</span>
					<span class="lo-row__chevron"><AppIcon Name="chevron-right" Size="18" /></span>
				</a>
			</li>
		}
	</ul>
</div>

@code {
	private static readonly ModuleEntry[] Modules =
	[
		new("Finance", "Transactions, accounts and categories", "finance", "finance"),
		new("Gym", "Train and manage workout programs", "gym", "gym")
	];

	private sealed record ModuleEntry(string Name, string Description, string Icon, string Href);
}
