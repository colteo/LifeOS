@page "/finance/accounts"
@using System.Globalization
@inject AccountsApiClient AccountsApi

<h1>Accounts</h1>

@if (!hasLoadedAccounts && isLoading)
{
    <p><em>Loading accounts...</em></p>
}
else if (!hasLoadedAccounts && loadError is not null)
{
    <div class="alert alert-danger" role="alert">@loadError</div>
}
else if (accounts.Count == 0)
{
    <p>No accounts yet. Add your first account below.</p>
}
else
{
    @if (loadError is not null)
    {
        @* A reload failed: the previously loaded list is kept. *@
        <div class="alert alert-danger" role="alert">@loadError</div>
    }

    @if (balancesError)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center gap-2" role="alert">
            <span>Unable to load balances.</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">Retry</button>
        </div>
    }

    @* Balances are authoritative from the API (ADR-007) and shown with their sign as returned:
       negative is a debt (e.g. a credit card), not an error. *@
    <ul class="list-group mb-3">
        @foreach (var account in accounts)
        {
            var balance = balancesByAccountId.GetValueOrDefault(account.Id)?.Balance;

            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-baseline gap-3">
                    <span class="fw-semibold text-break">@account.Name</span>
                    @if (balance is { } amount)
                    {
                        <span class="text-nowrap text-end">@FormatBalance(amount, account.Currency)</span>
                    }
                    else
                    {
                        <span class="text-nowrap text-end text-muted small">Balance unavailable</span>
                    }
                </div>
                <div class="text-muted small">
                    @AccountTypeOptions.Label(account.Type)@(balance is null ? $" · {account.Currency}" : null)
                </div>
            </li>
        }
    </ul>
}

<h2 class="h4 mt-4">Add account</h2>

<EditForm Model="form" OnSubmit="CreateAccountAsync">
    <div class="mb-3">
        <label for="account-name" class="form-label">Name</label>
        <InputText id="account-name" class="form-control" @bind-Value="form.Name" />
    </div>

    <div class="mb-3">
        <label for="account-type" class="form-label">Type</label>
        <InputSelect id="account-type" class="form-select" @bind-Value="form.Type">
            @foreach (var accountType in AccountTypeOptions.All)
            {
                <option value="@accountType">@accountType</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label for="account-currency" class="form-label">Currency</label>
        <InputText id="account-currency" class="form-control" @bind-Value="form.Currency" />
    </div>

    <CurrentBalanceFields Input="currentBalance" AccountType="@form.Type" IdPrefix="account" />

    @if (saveErrors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
                @foreach (var error in saveErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <button type="submit" class="btn btn-primary" disabled="@isSaving">
        @(isSaving ? "Saving..." : "Add account")
    </button>
</EditForm>

@code {
    private IReadOnlyList<AccountResponse> accounts = [];
    private IReadOnlyDictionary<Guid, AccountBalanceResponse> balancesByAccountId = new Dictionary<Guid, AccountBalanceResponse>();
    private bool hasLoadedAccounts;
    private bool isLoading = true;
    private string? loadError;
    private bool balancesError;

    // Only the latest load may update the page (e.g. a reload after creating an account).
    private int loadVersion;

    private NewAccountForm form = new();
    private readonly CurrentBalanceInput currentBalance = new(DateTime.Now);
    private bool isSaving;
    private IReadOnlyList<string> saveErrors = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    // Accounts and their balances, in parallel. A previously loaded list stays visible while reloading.
    private async Task LoadAsync()
    {
        var version = ++loadVersion;
        isLoading = true;

        var accountsTask = AccountsApi.GetAccountsAsync();
        var balancesTask = AccountsApi.GetBalancesAsync();
        await Task.WhenAll(accountsTask, balancesTask);

        if (version != loadVersion)
        {
            return;
        }

        var accountsResult = accountsTask.Result;
        var balancesResult = balancesTask.Result;

        if (accountsResult.IsSuccess)
        {
            accounts = accountsResult.Value!;
            hasLoadedAccounts = true;
            loadError = null;
        }
        else
        {
            loadError = string.Join(" ", accountsResult.Errors);
        }

        // Joined by account id; the two lists are not assumed to share an order. Accounts without a
        // balance entry show "Balance unavailable".
        balancesError = !balancesResult.IsSuccess;
        balancesByAccountId = balancesResult.IsSuccess
            ? balancesResult.Value!.ToDictionary(balance => balance.AccountId)
            : new Dictionary<Guid, AccountBalanceResponse>();

        isLoading = false;
    }

    // Culture-aware, 2 to 4 decimals (amounts have at most 4), sign as returned.
    private static string FormatBalance(decimal amount, string currency) =>
        $"{amount.ToString("#,##0.00##", CultureInfo.CurrentCulture)} {currency}";

    private async Task CreateAccountAsync()
    {
        if (isSaving)
        {
            return;
        }

        // Local checks first; on any error all input is kept.
        if (!currentBalance.TryBuildRequest(DateTimeOffset.UtcNow, TimeZoneInfo.Local, out var openingBalance, out var balanceError))
        {
            saveErrors = [balanceError!];
            return;
        }

        isSaving = true;
        saveErrors = [];

        // The account and its optional opening balance are created together, in one request.
        var result = await AccountsApi.CreateAccountAsync(
            new CreateAccountRequest(form.Name, form.Type, form.Currency, openingBalance));

        if (result.IsSuccess)
        {
            form = new NewAccountForm();
            currentBalance.Reset(DateTime.Now);
            await LoadAsync();
        }
        else
        {
            saveErrors = result.Errors;
        }

        isSaving = false;
    }

    private sealed class NewAccountForm
    {
        public string Name { get; set; } = string.Empty;

        public string Type { get; set; } = "BankAccount";

        public string Currency { get; set; } = "EUR";
    }
}
