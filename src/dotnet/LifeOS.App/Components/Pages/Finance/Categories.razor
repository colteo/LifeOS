@page "/finance/categories"
@inject CategoriesApiClient CategoriesApi

@* Category management: one type at a time, as a two-level tree. Indentation shows the hierarchy.
   Every form and action panel opens inline (new category at the top of the tree, a subcategory and
   ⋮ actions under their row), one at a time. *@

<PageHeader Title="Categories" BackHref="finance" />

@if (!hasLoaded && isLoading)
{
	<p class="lo-muted"><em>Loading categories...</em></p>
}
else if (!hasLoaded && loadError is not null)
{
	<div class="alert alert-danger d-flex justify-content-between align-items-center gap-2" role="alert">
		<span>@loadError</span>
		<button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">Retry</button>
	</div>
}
else
{
	@if (loadError is not null)
	{
		@* A reload failed: the previously loaded tree is kept. *@
		<div class="alert alert-warning d-flex justify-content-between align-items-center gap-2" role="alert">
			<span>@loadError</span>
			<button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">Retry</button>
		</div>
	}

	<div class="lo-segmented mb-2" role="group" aria-label="Category type">
		@foreach (var (type, title) in Sections)
		{
			<button type="button"
					class="lo-segmented__option"
					aria-pressed="@(type == selectedType ? "true" : "false")"
					disabled="@isSaving"
					@onclick="() => SelectType(type)">
				@title
			</button>
		}
	</div>

	var section = CategoryTree.Build(categories, selectedType);
	var creatingTopLevel = IsOpen(selectedType, parentId: null);

	<div class="lo-section-header">
		<h2 class="lo-section-title">@SectionTitle</h2>
		<button type="button" class="lo-header-action" aria-expanded="@(creatingTopLevel ? "true" : "false")" aria-controls="new-category-form"
				disabled="@isSaving" @onclick="() => ToggleNewCategory(selectedType)">
			<AppIcon Name="plus" Size="18" StrokeWidth="2.2" />
			New category
		</button>
	</div>

	<div class="lo-card">
		@if (creatingTopLevel)
		{
			<div id="new-category-form" class="pt-2">
				@CreateForm("New category")
			</div>
		}

		@if (section.TopLevel.Count == 0 && section.Unlinked.Count == 0)
		{
			<p class="lo-empty">No categories.</p>
		}
		else
		{
			<ul class="lo-list">
				@foreach (var node in section.TopLevel)
				{
					var parent = node.Category;

					<li>
						<div class="lo-row lo-row--center">
							<span class="lo-row__main lo-row__title text-break">@parent.Name</span>
							<button type="button"
									class="lo-icon-btn"
									aria-label="Add subcategory to @parent.Name"
									aria-expanded="@(IsOpen(selectedType, parent.Id) ? "true" : "false")"
									disabled="@isSaving"
									@onclick="() => Open(selectedType, parent)">
								<AppIcon Name="plus" Size="20" />
							</button>
							@ActionsButton(parent)
						</div>

						@if (IsActionOpen(parent.Id))
						{
							@ActionPanel(parent)
						}

						@if (node.Children.Count > 0)
						{
							<ul class="list-unstyled mb-0 lo-category-children">
								@foreach (var child in node.Children)
								{
									<li>
										<div class="lo-row lo-row--center">
											<span class="lo-row__main text-break">@child.Name</span>
											@ActionsButton(child)
										</div>

										@if (IsActionOpen(child.Id))
										{
											@ActionPanel(child)
										}
									</li>
								}
							</ul>
						}

						@if (IsOpen(selectedType, parent.Id))
						{
							@CreateForm($"New subcategory of {parent.Name}")
						}
					</li>
				}
			</ul>

			@if (section.Unlinked.Count > 0)
			{
				@* Subcategories whose parent is not among this section's top-level categories. *@
				<p class="lo-day-title mx-3">Unlinked categories</p>
				<ul class="lo-list">
					@foreach (var category in section.Unlinked)
					{
						<li>
							<div class="lo-row lo-row--center">
								<span class="lo-row__main text-break">@category.Name</span>
								@ActionsButton(category)
							</div>

							@if (IsActionOpen(category.Id))
							{
								@ActionPanel(category)
							}
						</li>
					}
				</ul>
			}
		}
	</div>
}

@code {
	private static readonly (string Type, string Title)[] Sections = [("Expense", "Expenses"), ("Income", "Income")];

	private IReadOnlyList<CategoryResponse> categories = [];
	private bool hasLoaded;

	// The type shown (UI state only): one section at a time.
	private string selectedType = "Expense";
	private bool isLoading = true;
	private string? loadError;

	// Only the latest load may update the page.
	private int loadVersion;

	// The one form or panel open on the whole page: a create form (a new top-level category of a
	// type, or a new subcategory of a top-level parent) or the action panel of one category.
	// Opening any of them closes the other.
	private OpenForm? openForm;
	private CategoryResponse? actionTarget;
	private ActionPanelKind actionPanel;
	private string formName = string.Empty;
	private IReadOnlyList<string> formErrors = [];
	private bool isSaving;

	protected override Task OnInitializedAsync() => LoadAsync();

	private async Task LoadAsync()
	{
		var version = ++loadVersion;
		isLoading = true;

		var result = await CategoriesApi.GetCategoriesAsync();

		if (version != loadVersion)
		{
			return;
		}

		if (result.IsSuccess)
		{
			categories = result.Value!;
			hasLoaded = true;
			loadError = null;
		}
		else
		{
			loadError = string.Join(" ", result.Errors);
		}

		isLoading = false;
	}

	// Switching type closes any open form or panel: they belong to the section on screen.
	private void SelectType(string type)
	{
		if (isSaving || type == selectedType)
		{
			return;
		}

		Close();
		selectedType = type;
	}

	// "Expense categories" / "Income categories": the section on screen.
	private string SectionTitle => $"{selectedType} categories";

	private bool IsOpen(string type, Guid? parentId) =>
		openForm is { } form && form.Type == type && form.Parent?.Id == parentId;

	private bool IsActionOpen(Guid categoryId) => actionTarget?.Id == categoryId;

	private void Open(string type, CategoryResponse? parent)
	{
		if (isSaving)
		{
			return;
		}

		actionTarget = null;
		openForm = new OpenForm(type, parent);
		formName = string.Empty;
		formErrors = [];
	}

	// "+ New category" toggles the top-level create form.
	private void ToggleNewCategory(string type)
	{
		if (IsOpen(type, parentId: null))
		{
			if (!isSaving)
			{
				Close();
			}

			return;
		}

		Open(type, null);
	}

	// ⋮ toggles the category's action panel (Rename, Delete).
	private void ToggleActions(CategoryResponse category)
	{
		if (isSaving)
		{
			return;
		}

		var wasOpen = IsActionOpen(category.Id);
		Close();

		if (!wasOpen)
		{
			actionTarget = category;
			actionPanel = ActionPanelKind.Actions;
		}
	}

	private void ShowRename()
	{
		formName = actionTarget?.Name ?? string.Empty;
		formErrors = [];
		actionPanel = ActionPanelKind.Rename;
	}

	private void ShowConfirmDelete()
	{
		formErrors = [];
		actionPanel = ActionPanelKind.ConfirmDelete;
	}

	private void Close()
	{
		openForm = null;
		actionTarget = null;
		formName = string.Empty;
		formErrors = [];
	}

	// The type comes from the section and the parent from the row: neither can be changed here.
	// After an error (duplicate name, stale parent, network) the typed name is kept and nothing is
	// retried automatically.
	private async Task SaveAsync()
	{
		if (isSaving || openForm is not { } form)
		{
			return;
		}

		var name = formName.Trim();

		if (name.Length == 0)
		{
			formErrors = ["Enter a name."];
			return;
		}

		isSaving = true;
		formErrors = [];

		var result = await CategoriesApi.CreateCategoryAsync(new CreateCategoryRequest(name, form.Type, form.Parent?.Id));

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	// Only the name changes. On an error (duplicate at this level, deleted meanwhile, network) the
	// typed name is kept.
	private async Task RenameAsync()
	{
		if (isSaving || actionTarget is not { } category)
		{
			return;
		}

		var name = formName.Trim();

		if (name.Length == 0)
		{
			formErrors = ["Enter a name."];
			return;
		}

		isSaving = true;
		formErrors = [];

		var result = await CategoriesApi.RenameCategoryAsync(category.Id, name);

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	// The server decides: a category with subcategories or transactions is kept, and the panel
	// shows why. Nothing is cascaded.
	private async Task DeleteAsync()
	{
		if (isSaving || actionTarget is not { } category)
		{
			return;
		}

		isSaving = true;
		formErrors = [];

		var result = await CategoriesApi.DeleteCategoryAsync(category.Id);

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	// On success the form or panel closes and the tree reloads through the guarded load; on failure
	// it stays open with the reason.
	private async Task FinishAsync(bool succeeded, IReadOnlyList<string> errors)
	{
		if (succeeded)
		{
			Close();
			await LoadAsync();
		}
		else
		{
			formErrors = errors;
		}

		isSaving = false;
	}

	private RenderFragment ActionsButton(CategoryResponse category) =>
		@<button type="button"
				 class="lo-icon-btn"
				 aria-label="Actions for @category.Name"
				 aria-expanded="@(IsActionOpen(category.Id) ? "true" : "false")"
				 disabled="@isSaving"
				 @onclick="() => ToggleActions(category)"><AppIcon Name="more-vertical" /></button>;

	private RenderFragment ActionPanel(CategoryResponse category) =>
		@<div class="lo-panel">
			@switch (actionPanel)
			{
				case ActionPanelKind.Rename:
					<form @onsubmit="RenameAsync" @onsubmit:preventDefault="true">
						<label for="rename-category-name" class="form-label small">Name</label>
						<input id="rename-category-name" class="form-control" autocomplete="off" @bind="formName" @bind:event="oninput" />
						@FormErrors()
						<div class="d-flex gap-2 mt-2">
							<button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">@(isSaving ? "Saving..." : "Save")</button>
							<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="Close">Cancel</button>
						</div>
					</form>
					break;

				case ActionPanelKind.ConfirmDelete:
					<p class="small mb-2">Delete <span class="fw-semibold">@category.Name</span>? This can't be undone.</p>
					@FormErrors()
					<div class="d-flex gap-2 mt-2">
						<button type="button" class="btn btn-danger btn-sm" disabled="@isSaving" @onclick="DeleteAsync">@(isSaving ? "Deleting..." : "Delete")</button>
						<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="Close">Cancel</button>
					</div>
					break;

				default:
					<div class="d-flex flex-column align-items-start">
						<button type="button" class="btn btn-link btn-sm px-0" @onclick="ShowRename">Rename</button>
						<button type="button" class="btn btn-link btn-sm px-0 text-danger" @onclick="ShowConfirmDelete">Delete</button>
					</div>
					break;
			}
		</div>;

	private RenderFragment CreateForm(string title) =>
		@<form class="lo-panel mt-1" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
			<p class="small fw-semibold mb-2">@title</p>
			<label for="category-name" class="form-label small">Name</label>
			<input id="category-name" class="form-control" autocomplete="off" @bind="formName" @bind:event="oninput" />

			@FormErrors()

			<div class="d-flex gap-2 mt-2">
				<button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">@(isSaving ? "Saving..." : "Save")</button>
				<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="Close">Cancel</button>
			</div>
		</form>;

	private RenderFragment FormErrors() =>
		@<text>
			@if (formErrors.Count > 0)
			{
				<div class="alert alert-danger mt-2 mb-0 py-2 small" role="alert">
					@foreach (var error in formErrors)
					{
						<div>@error</div>
					}
				</div>
			}
		</text>;

	private sealed record OpenForm(string Type, CategoryResponse? Parent);

	private enum ActionPanelKind
	{
		Actions,
		Rename,
		ConfirmDelete
	}
}
