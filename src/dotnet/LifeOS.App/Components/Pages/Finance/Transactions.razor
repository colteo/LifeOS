@page "/finance/transactions"
@using System.Globalization
@inject AccountsApiClient AccountsApi
@inject CategoriesApiClient CategoriesApi
@inject TransactionsApiClient TransactionsApi
@inject RecurringApiClient RecurringApi
@using LifeOS.Contracts.Finance.Recurring

@* Transaction history, one local calendar month at a time, grouped by local day. Entry lives on
   /finance/transactions/new (the dock's "+"). *@

<PageHeader Title="Transactions" BackHref="finance" BackLabel="Finance" />

@if (isLoading)
{
    <p class="lo-muted"><em>Loading transactions...</em></p>
}
else if (loadErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in loadErrors)
        {
            <div>@error</div>
        }
    </div>
    <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync">Retry</button>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-2">
        <button type="button" class="lo-icon-btn lo-icon-btn--outlined" aria-label="Previous month" @onclick="() => ChangeMonthAsync(-1)">
            <AppIcon Name="chevron-left" Size="20" />
        </button>
        <h2 class="lo-section-title">@MonthLabel</h2>
        <button type="button" class="lo-icon-btn lo-icon-btn--outlined" aria-label="Next month" @onclick="() => ChangeMonthAsync(1)">
            <AppIcon Name="chevron-right" Size="20" />
        </button>
    </div>

    @if (isHistoryLoading)
    {
        <p class="lo-muted mt-3"><em>Loading transactions...</em></p>
    }
    else if (historyErrors.Count > 0)
    {
        <div class="alert alert-danger mt-3" role="alert">
            @foreach (var error in historyErrors)
            {
                <div>@error</div>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" @onclick="LoadHistoryAsync">Retry</button>
    }
    else if (historyDays.Count == 0)
    {
        <div class="lo-card mt-3">
            <p class="lo-empty">No transactions for this month.</p>
        </div>
    }
    else
    {
        foreach (var day in historyDays)
        {
            <h3 class="lo-day-title">@DayLabel(day.Date)</h3>
            <div class="lo-card">
                <ul class="lo-list">
                    @foreach (var transaction in day.Transactions)
                    {
                        <TransactionRow Transaction="transaction" Accounts="accounts" Categories="categories" When="@LocalTimeText(transaction)"
                                        Href="@($"finance/transactions/{transaction.Id}")" />
                    }
                </ul>
            </div>
        }
    }
    <h2 class="lo-section-title mt-4">Recurring planning</h2>
    <p class="lo-muted">Expected movements for @MonthLabel. Confirmation creates an actual transaction.</p>
    @if (isHistoryLoading) { <p class="lo-muted">Loading plans...</p> }
    else if (planningErrors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">@string.Join(" ", planningErrors)</div>
        <button class="btn btn-outline-secondary" @onclick="LoadHistoryAsync">Retry planning</button>
    }
    else
    {
        <div class="lo-card p-3">
            @if (plannedOccurrences.Count == 0) { <p class="lo-empty">No recurring plans for this month.</p> }
            @foreach (var occurrence in plannedOccurrences)
            {
                <div class="mb-3" @key="(occurrence.RuleId, occurrence.Year, occurrence.Month)">
                    <strong>@occurrence.Name</strong> · @occurrence.ScheduledDate.ToString("MMMM d", CultureInfo.GetCultureInfo("en-US")) · @occurrence.Status
                    <div>@AnalyticsDisplay.Amount(occurrence.ExpectedAmount, occurrence.Currency) · @occurrence.Type</div>
                    <RecurringOccurrenceActions Occurrence="occurrence"
                        AccountName="@(accounts.FirstOrDefault(a => a.Id == occurrence.AccountId)?.Name ?? "Account")"
                        CategoryName="@(categories.FirstOrDefault(c => c.Id == occurrence.CategoryId)?.Name ?? "Category")"
                        Changed="LoadHistoryAsync" />
                </div>
            }
            <a href="finance/recurring">Manage recurring plans</a>
        </div>
    }
}

@code {
    private IReadOnlyList<AccountResponse> accounts = [];
    private IReadOnlyList<CategoryResponse> categories = [];
    private bool isLoading = true;
    private IReadOnlyList<string> loadErrors = [];

    // History: one local calendar month at a time, grouped by local day.
    private DateTime selectedMonth = LocalMonth.Containing(DateTime.Today);
    private IReadOnlyList<HistoryDay> historyDays = [];
    private bool isHistoryLoading = true;
    private IReadOnlyList<string> historyErrors = [];
    private int historyRequestVersion;
    private IReadOnlyList<RecurringOccurrenceResponse> plannedOccurrences = [];
    private IReadOnlyList<string> planningErrors = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    // Account and category names (for the rows) and the month's history, in parallel.
    private async Task LoadAsync()
    {
        isLoading = true;
        loadErrors = [];

        var accountsTask = AccountsApi.GetAccountsAsync();
        var categoriesTask = CategoriesApi.GetCategoriesAsync();
        var historyTask = LoadHistoryAsync();
        await Task.WhenAll(accountsTask, categoriesTask, historyTask);

        var accountsResult = accountsTask.Result;
        var categoriesResult = categoriesTask.Result;

        if (accountsResult.IsSuccess && categoriesResult.IsSuccess)
        {
            accounts = accountsResult.Value!;
            categories = categoriesResult.Value!;
        }
        else
        {
            // Both clients report the same message when the API is unreachable; show it once.
            loadErrors = accountsResult.Errors.Concat(categoriesResult.Errors).Distinct().ToList();
        }

        isLoading = false;
    }

    private async Task ChangeMonthAsync(int months)
    {
        selectedMonth = selectedMonth.AddMonths(months);
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        // Rapid month changes: only the latest request may update the page.
        var requestVersion = ++historyRequestVersion;

        isHistoryLoading = true;
        historyErrors = [];
        planningErrors = [];

        // Both requests capture the same selected local month. Action completion reloads both.
        var month = selectedMonth;
        try
        {
            var data = await TransactionMonthLoader.LoadAsync(month, TimeZoneInfo.Local, TransactionsApi, RecurringApi);
            var result = data.History;

            if (requestVersion != historyRequestVersion)
            {
                return;
            }

            if (result.IsSuccess)
            {
                // Group by the device-local calendar day, never by the UTC date. The API already
                // orders newest first; GroupBy keeps that order inside each day.
                historyDays = result.Value!
                    .GroupBy(transaction => ToLocal(transaction.OccurredAtUtc).Date)
                    .OrderByDescending(group => group.Key)
                    .Select(group => new HistoryDay(group.Key, group.ToList()))
                    .ToList();
            }
            else
            {
                historyDays = [];
                historyErrors = result.Errors;
            }

            var planning = data.Planning;
            plannedOccurrences = planning.IsSuccess
                ? RecurringPlanning.ForMonth(planning.Value!.Occurrences, month.Year, month.Month)
                : [];
            planningErrors = planning.Errors;
        }
        catch (Exception)
        {
            if (requestVersion != historyRequestVersion) return;
            historyDays = []; plannedOccurrences = [];
            historyErrors = planningErrors = ["Could not refresh this month's movements. Retry to load history and planning."];
        }
        finally
        {
            if (requestVersion == historyRequestVersion) isHistoryLoading = false;
        }
    }

    // Month names are English UI text ("September 2026"), whatever the device culture.
    private string MonthLabel => LocalMonth.Label(selectedMonth);

    private static string DayLabel(DateTime localDate) => TransactionDisplay.DayLabel(localDate, DateTime.Today);

    private static string LocalTimeText(TransactionResponse transaction) =>
        ToLocal(transaction.OccurredAtUtc).ToString(CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern, CultureInfo.CurrentCulture);

    private static DateTimeOffset ToLocal(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.Local);

    private sealed record HistoryDay(DateTime Date, IReadOnlyList<TransactionResponse> Transactions);
}
