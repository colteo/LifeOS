@page "/finance/transactions"
@using System.Globalization
@inject AccountsApiClient AccountsApi
@inject CategoriesApiClient CategoriesApi
@inject TransactionsApiClient TransactionsApi
@inject RecurringApiClient RecurringApi
@inject PlannedExpensesApiClient PlannedApi
@inject NavigationManager Navigation
@using LifeOS.Contracts.Finance.PlannedExpenses
@using LifeOS.Contracts.Finance.Recurring

@* One local calendar month at a time, in two tabs: Actual (recorded history, grouped by local day) and
   Planned (unresolved recurring occurrences and one-off planned expenses, kept as separate groups).
   Entry lives on /finance/transactions/new (the dock's "+"). ?tab=planned opens the Planned tab. *@

<PageHeader Title="Transactions" BackHref="finance" BackLabel="Finance" />

@if (isLoading)
{
    <p class="lo-muted"><em>Loading transactions...</em></p>
}
else if (loadErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in loadErrors)
        {
            <div>@error</div>
        }
    </div>
    <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync">Retry</button>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-2">
        <button type="button" class="lo-icon-btn lo-icon-btn--outlined" aria-label="Previous month" @onclick="() => ChangeMonthAsync(-1)">
            <AppIcon Name="chevron-left" Size="20" />
        </button>
        <h2 class="lo-section-title">@MonthLabel</h2>
        <button type="button" class="lo-icon-btn lo-icon-btn--outlined" aria-label="Next month" @onclick="() => ChangeMonthAsync(1)">
            <AppIcon Name="chevron-right" Size="20" />
        </button>
    </div>

    <div class="lo-segmented mb-3" role="tablist" aria-label="Transactions view">
        <button type="button" role="tab" id="transactions-tab-actual" class="lo-segmented__option"
                aria-selected="@IsActive(TransactionsTab.Actual)" aria-pressed="@IsActive(TransactionsTab.Actual)" aria-controls="transactions-panel"
                @onclick="() => SelectTab(TransactionsTab.Actual)">
            Actual
        </button>
        <button type="button" role="tab" id="transactions-tab-planned" class="lo-segmented__option"
                aria-selected="@IsActive(TransactionsTab.Planned)" aria-pressed="@IsActive(TransactionsTab.Planned)" aria-controls="transactions-panel"
                @onclick="() => SelectTab(TransactionsTab.Planned)">
            @PlannedMonthView.PlannedTabLabel(isHistoryLoading ? 0 : planned.DueCount)
        </button>
    </div>

    <div id="transactions-panel" role="tabpanel" aria-labelledby="@(ActiveTab == TransactionsTab.Planned ? "transactions-tab-planned" : "transactions-tab-actual")">
        @if (ActiveTab == TransactionsTab.Actual)
        {
            <p class="lo-muted">Recorded transactions for @MonthLabel. Planned movements stay in the Planned tab until you confirm them.</p>

            @if (isHistoryLoading)
            {
                <p class="lo-muted mt-3"><em>Loading transactions...</em></p>
            }
            else if (historyErrors.Count > 0)
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @foreach (var error in historyErrors)
                    {
                        <div>@error</div>
                    }
                </div>
                <button type="button" class="btn btn-outline-secondary" @onclick="LoadHistoryAsync">Retry</button>
            }
            else if (historyDays.Count == 0)
            {
                <div class="lo-card mt-3">
                    <p class="lo-empty">No transactions for this month.</p>
                </div>
            }
            else
            {
                foreach (var day in historyDays)
                {
                    <h3 class="lo-day-title">@DayLabel(day.Date)</h3>
                    <div class="lo-card">
                        <ul class="lo-list">
                            @foreach (var transaction in day.Transactions)
                            {
                                <TransactionRow Transaction="transaction" Accounts="accounts" Categories="categories" When="@LocalTimeText(transaction)"
                                                Href="@($"finance/transactions/{transaction.Id}")" />
                            }
                        </ul>
                    </div>
                }
            }
        }
        else
        {
            <p class="lo-muted">Expected movements for @MonthLabel. They do not change balances, spending or analytics until you confirm them, which records an actual transaction.</p>

            <section class="lo-plan-section" aria-labelledby="planned-recurring-title">
                <div class="lo-section-header">
                    <h3 class="lo-section-title" id="planned-recurring-title">Recurring</h3>
                    <a href="finance/recurring" class="lo-section-link">Manage rules</a>
                </div>
                <p class="lo-plan-hint">Repeats monthly. Due: Review &amp; Confirm or Skip this month. Expected: Skip only.</p>
                @if (isHistoryLoading) { <p class="lo-muted">Loading recurring plans...</p> }
                else if (planningErrors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">@string.Join(" ", planningErrors)</div>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadHistoryAsync">Retry planning</button>
                }
                else if (planned.Recurring.Count == 0)
                {
                    <div class="lo-card"><p class="lo-empty">No recurring movements to confirm this month.</p></div>
                }
                else
                {
                    <div class="lo-card">
                        <ul class="lo-list">
                            @foreach (var occurrence in planned.Recurring)
                            {
                                <li class="lo-plan-item" @key="(occurrence.RuleId, occurrence.Year, occurrence.Month)">
                                    <div class="lo-plan-item__row">
                                        <span class="lo-row__main">
                                            <span class="lo-row__title d-block">@occurrence.Name</span>
                                            <span class="lo-row__sub d-block">@occurrence.Type · @AccountName(occurrence.AccountId) · @CategoryName(occurrence.CategoryId)</span>
                                            <span class="lo-row__sub d-block">@ScheduledText(occurrence.ScheduledDate)</span>
                                        </span>
                                        <span class="lo-row__end">
                                            <span class="lo-amount">@AnalyticsDisplay.Amount(occurrence.ExpectedAmount, occurrence.Currency)</span>
                                            <span class="lo-plan-status @StatusCssClass(occurrence.Status)">@PlannedMonthView.StatusLabel(occurrence.Status)</span>
                                        </span>
                                    </div>
                                    <div class="lo-plan-item__actions">
                                        <RecurringOccurrenceActions Occurrence="occurrence"
                                            AccountName="@AccountName(occurrence.AccountId)"
                                            CategoryName="@CategoryName(occurrence.CategoryId)"
                                            Changed="LoadHistoryAsync" />
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </section>

            <section class="lo-plan-section" aria-labelledby="planned-oneoff-title">
                <div class="lo-section-header">
                    <h3 class="lo-section-title" id="planned-oneoff-title">One-off</h3>
                    <a href="finance/planned-expenses" class="lo-section-link">Manage expenses</a>
                </div>
                <p class="lo-plan-hint">Happens once. Due: Review &amp; Confirm or Cancel. Expected: Cancel only. Edit, restore or delete in Manage expenses.</p>
                @if (isHistoryLoading) { <p class="lo-muted">Loading one-off plans...</p> }
                else if (oneOffErrors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">@string.Join(" ", oneOffErrors)</div>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadHistoryAsync">Retry planning</button>
                }
                else if (planned.OneOff.Count == 0)
                {
                    <div class="lo-card"><p class="lo-empty">No one-off expenses to confirm this month.</p></div>
                }
                else
                {
                    <div class="lo-card">
                        <ul class="lo-list">
                            @foreach (var item in planned.OneOff)
                            {
                                <li class="lo-plan-item" @key="item.Id">
                                    <div class="lo-plan-item__row">
                                        <span class="lo-row__main">
                                            <span class="lo-row__title d-block">@item.Name</span>
                                            <span class="lo-row__sub d-block">Expense · @AccountName(item.AccountId) · @CategoryName(item.CategoryId)</span>
                                            <span class="lo-row__sub d-block">@ScheduledText(item.ScheduledDate)</span>
                                        </span>
                                        <span class="lo-row__end">
                                            <span class="lo-amount">@AnalyticsDisplay.Amount(item.ExpectedAmount, item.Currency)</span>
                                            <span class="lo-plan-status @StatusCssClass(item.Status)">@PlannedMonthView.StatusLabel(item.Status)</span>
                                        </span>
                                    </div>
                                    <div class="lo-plan-item__actions">
                                        <PlannedExpenseActions Occurrence="item"
                                            AccountName="@AccountName(item.AccountId)"
                                            CategoryName="@CategoryName(item.CategoryId)"
                                            Changed="LoadHistoryAsync" />
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </section>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = TransactionsTabs.QueryName)]
    public string? Tab { get; set; }

    private IReadOnlyList<AccountResponse> accounts = [];
    private IReadOnlyList<CategoryResponse> categories = [];
    private bool isLoading = true;
    private IReadOnlyList<string> loadErrors = [];

    // History and planning: one local calendar month at a time; history grouped by local day.
    private DateTime selectedMonth = LocalMonth.Containing(DateTime.Today);
    private IReadOnlyList<HistoryDay> historyDays = [];
    private bool isHistoryLoading = true;
    private IReadOnlyList<string> historyErrors = [];
    private int historyRequestVersion;
    private PlannedMonthView planned = PlannedMonthView.Empty;
    private IReadOnlyList<string> planningErrors = [];
    private IReadOnlyList<string> oneOffErrors = [];

    private TransactionsTab ActiveTab => TransactionsTabs.Parse(Tab);

    protected override Task OnInitializedAsync() => LoadAsync();

    // The tab lives in the query string (replacing the history entry) so the selected month and loaded data
    // stay in this component instance while switching.
    private void SelectTab(TransactionsTab tab)
    {
        if (tab == ActiveTab) return;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(TransactionsTabs.QueryName, TransactionsTabs.QueryValue(tab)), replace: true);
    }

    private string IsActive(TransactionsTab tab) => tab == ActiveTab ? "true" : "false";

    // Account and category names (for the rows) and the month's history, in parallel.
    private async Task LoadAsync()
    {
        isLoading = true;
        loadErrors = [];

        var accountsTask = AccountsApi.GetAccountsAsync();
        var categoriesTask = CategoriesApi.GetCategoriesAsync();
        var historyTask = LoadHistoryAsync();
        await Task.WhenAll(accountsTask, categoriesTask, historyTask);

        var accountsResult = accountsTask.Result;
        var categoriesResult = categoriesTask.Result;

        if (accountsResult.IsSuccess && categoriesResult.IsSuccess)
        {
            accounts = accountsResult.Value!;
            categories = categoriesResult.Value!;
        }
        else
        {
            // Both clients report the same message when the API is unreachable; show it once.
            loadErrors = accountsResult.Errors.Concat(categoriesResult.Errors).Distinct().ToList();
        }

        isLoading = false;
    }

    private async Task ChangeMonthAsync(int months)
    {
        selectedMonth = selectedMonth.AddMonths(months);
        await LoadHistoryAsync();
    }

    // Loads both tabs for the selected month: a confirmation creates an actual transaction and removes
    // the plan, so action completion and month navigation always refresh history and planning together.
    private async Task LoadHistoryAsync()
    {
        // Rapid month changes: only the latest request may update the page.
        var requestVersion = ++historyRequestVersion;

        isHistoryLoading = true;
        historyErrors = [];
        planningErrors = [];
        oneOffErrors = [];

        // All requests capture the same selected local month.
        var month = selectedMonth;
        try
        {
            var oneOffTask = PlannedApi.QueryAsync(month, month);
            var data = await TransactionMonthLoader.LoadAsync(month, TimeZoneInfo.Local, TransactionsApi, RecurringApi);
            var oneOff = await oneOffTask;
            var result = data.History;

            if (requestVersion != historyRequestVersion)
            {
                return;
            }

            if (result.IsSuccess)
            {
                // Group by the device-local calendar day, never by the UTC date. The API already
                // orders newest first; GroupBy keeps that order inside each day.
                historyDays = result.Value!
                    .GroupBy(transaction => ToLocal(transaction.OccurredAtUtc).Date)
                    .OrderByDescending(group => group.Key)
                    .Select(group => new HistoryDay(group.Key, group.ToList()))
                    .ToList();
            }
            else
            {
                historyDays = [];
                historyErrors = result.Errors;
            }

            var planning = data.Planning;
            planned = PlannedMonthView.ForMonth(
                planning.IsSuccess ? planning.Value!.Occurrences : [],
                oneOff.IsSuccess ? oneOff.Value! : [],
                month.Year, month.Month);
            planningErrors = planning.Errors;
            oneOffErrors = oneOff.Errors;
        }
        catch (Exception)
        {
            if (requestVersion != historyRequestVersion) return;
            historyDays = []; planned = PlannedMonthView.Empty;
            historyErrors = planningErrors = oneOffErrors = ["Could not refresh this month's movements. Retry to load history and planning."];
        }
        finally
        {
            if (requestVersion == historyRequestVersion) isHistoryLoading = false;
        }
    }

    // Month names are English UI text ("September 2026"), whatever the device culture.
    private string MonthLabel => LocalMonth.Label(selectedMonth);

    private string AccountName(Guid id) => accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "Account";

    private string CategoryName(Guid id) => categories.FirstOrDefault(c => c.Id == id)?.Name ?? "Category";

    private static string ScheduledText(DateOnly date) => "Scheduled " + date.ToString("MMMM d", CultureInfo.GetCultureInfo("en-US"));

    private static string StatusCssClass(string status) => status == "Due" ? "lo-plan-status--due" : "lo-plan-status--expected";

    private static string DayLabel(DateTime localDate) => TransactionDisplay.DayLabel(localDate, DateTime.Today);

    private static string LocalTimeText(TransactionResponse transaction) =>
        ToLocal(transaction.OccurredAtUtc).ToString(CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern, CultureInfo.CurrentCulture);

    private static DateTimeOffset ToLocal(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.Local);

    private sealed record HistoryDay(DateTime Date, IReadOnlyList<TransactionResponse> Transactions);
}
