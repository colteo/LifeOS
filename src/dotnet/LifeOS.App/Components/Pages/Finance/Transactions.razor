@page "/finance/transactions"
@using System.Globalization
@inject AccountsApiClient AccountsApi
@inject CategoriesApiClient CategoriesApi
@inject TransactionsApiClient TransactionsApi

<h1>New transaction</h1>

@if (isLoading)
{
    <p><em>Loading accounts and categories...</em></p>
}
else if (loadErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in loadErrors)
        {
            <div>@error</div>
        }
    </div>
    <button type="button" class="btn btn-outline-primary" @onclick="LoadAsync">Retry</button>
}
else if (accounts.Count == 0)
{
    <p>You need an account before recording transactions. <a href="finance/accounts">Add an account</a>.</p>
}
else
{
    <div class="btn-group w-100 mb-3" role="group" aria-label="Transaction type">
        @foreach (var type in TransactionTypes)
        {
            <button type="button"
                    class="btn @(type == selectedType ? "btn-primary" : "btn-outline-primary")"
                    aria-pressed="@(type == selectedType ? "true" : "false")"
                    @onclick="() => SelectType(type)">
                @type
            </button>
        }
    </div>

    <EditForm Model="form" OnSubmit="SaveAsync">
        <div class="mb-3">
            <label for="transaction-amount" class="form-label">Amount</label>
            <InputText id="transaction-amount"
                       class="form-control form-control-lg"
                       inputmode="decimal"
                       autocomplete="off"
                       placeholder="0,00"
                       @bind-Value="form.Amount"
                       @bind-Value:after="ClearSuccess" />
        </div>

        @if (IsTransfer)
        {
            <div class="mb-3">
                <label for="transaction-source" class="form-label">From account</label>
                <InputSelect id="transaction-source" class="form-select" @bind-Value="form.SourceAccountId" @bind-Value:after="OnSourceChanged">
                    <option value="">Select an account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label for="transaction-destination" class="form-label">To account</label>
                <InputSelect id="transaction-destination" class="form-select" @bind-Value="form.DestinationAccountId" @bind-Value:after="ClearSuccess">
                    <option value="">Select an account</option>
                    @foreach (var account in accounts.Where(account => account.Id.ToString() != form.SourceAccountId))
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </InputSelect>
            </div>

            @if (SourceAccount is { } source && DestinationAccount is { } destination)
            {
                if (HasCurrencyMismatch)
                {
                    <div class="alert alert-warning" role="alert">
                        These accounts use different currencies (@source.Currency and @destination.Currency).
                        Transfers between currencies are not supported.
                    </div>
                }
                else
                {
                    <div class="form-text mb-3">Currency: @source.Currency</div>
                }
            }
        }
        else
        {
            <div class="mb-3">
                <label for="transaction-account" class="form-label">Account</label>
                <InputSelect id="transaction-account" class="form-select" @bind-Value="form.AccountId" @bind-Value:after="ClearSuccess">
                    <option value="">Select an account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </InputSelect>
                @if (SelectedAccount is { } selectedAccount)
                {
                    <div class="form-text">Currency: @selectedAccount.Currency</div>
                }
            </div>

            @if (TopLevelCategories.Count == 0)
            {
                <p class="text-muted">No @selectedType.ToLowerInvariant() categories available.</p>
            }
            else
            {
                <div class="mb-3">
                    <label for="transaction-category" class="form-label">Category</label>
                    <InputSelect id="transaction-category" class="form-select" @bind-Value="form.CategoryId" @bind-Value:after="OnCategoryChanged">
                        <option value="">Select a category</option>
                        @foreach (var category in TopLevelCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>

                @if (Subcategories.Count > 0)
                {
                    <div class="mb-3">
                        <label for="transaction-subcategory" class="form-label">Subcategory</label>
                        <InputSelect id="transaction-subcategory" class="form-select" @bind-Value="form.SubcategoryId" @bind-Value:after="ClearSuccess">
                            <option value="">No subcategory</option>
                            @foreach (var subcategory in Subcategories)
                            {
                                <option value="@subcategory.Id">@subcategory.Name</option>
                            }
                        </InputSelect>
                    </div>
                }
            }
        }

        <div class="mb-3">
            <label for="transaction-date" class="form-label">Date and time</label>
            <input id="transaction-date"
                   type="datetime-local"
                   class="form-control"
                   step="60"
                   @bind="form.OccurredAtLocal"
                   @bind:format="yyyy-MM-ddTHH:mm"
                   @bind:after="ClearSuccess" />
        </div>

        <div class="mb-3">
            <label for="transaction-note" class="form-label">Note (optional)</label>
            <InputTextArea id="transaction-note" class="form-control" rows="2" @bind-Value="form.Note" @bind-Value:after="ClearSuccess" />
        </div>

        @if (saveErrors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <ul class="mb-0">
                    @foreach (var error in saveErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        @if (successMessage is not null)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }

        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@(isSaving || HasCurrencyMismatch)">
            @(isSaving ? "Saving..." : $"Save {selectedType.ToLowerInvariant()}")
        </button>
    </EditForm>
}

@code {
    private const string Expense = "Expense";
    private const string Income = "Income";
    private const string Transfer = "Transfer";

    // External transaction type names, as used by the API contract.
    private static readonly string[] TransactionTypes = [Expense, Income, Transfer];

    private IReadOnlyList<AccountResponse> accounts = [];
    private IReadOnlyList<CategoryResponse> categories = [];
    private bool isLoading = true;
    private IReadOnlyList<string> loadErrors = [];

    private string selectedType = Expense;
    private TransactionForm form = new();
    private bool isSaving;
    private IReadOnlyList<string> saveErrors = [];
    private string? successMessage;

    private bool IsTransfer => selectedType == Transfer;

    private AccountResponse? SelectedAccount => FindAccount(form.AccountId);

    private AccountResponse? SourceAccount => FindAccount(form.SourceAccountId);

    private AccountResponse? DestinationAccount => FindAccount(form.DestinationAccountId);

    private bool HasCurrencyMismatch =>
        IsTransfer
        && SourceAccount is { } source
        && DestinationAccount is { } destination
        && source.Currency != destination.Currency;

    private IReadOnlyList<CategoryResponse> TopLevelCategories =>
        categories
            .Where(category => category.Type == selectedType && category.ParentCategoryId is null)
            .ToList();

    private IReadOnlyList<CategoryResponse> Subcategories =>
        Guid.TryParse(form.CategoryId, out var parentId)
            ? categories.Where(category => category.ParentCategoryId == parentId).ToList()
            : [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadErrors = [];

        var accountsTask = AccountsApi.GetAccountsAsync();
        var categoriesTask = CategoriesApi.GetCategoriesAsync();
        await Task.WhenAll(accountsTask, categoriesTask);

        var accountsResult = accountsTask.Result;
        var categoriesResult = categoriesTask.Result;

        if (accountsResult.IsSuccess && categoriesResult.IsSuccess)
        {
            accounts = accountsResult.Value!;
            categories = categoriesResult.Value!;
        }
        else
        {
            // Both clients report the same message when the API is unreachable; show it once.
            loadErrors = accountsResult.Errors.Concat(categoriesResult.Errors).Distinct().ToList();
        }

        isLoading = false;
    }

    private void SelectType(string type)
    {
        if (type == selectedType)
        {
            return;
        }

        var wasTransfer = IsTransfer;
        selectedType = type;

        // Categories never carry over: they are specific to Income or Expense.
        form.CategoryId = string.Empty;
        form.SubcategoryId = string.Empty;

        if (IsTransfer)
        {
            form.AccountId = string.Empty;
        }
        else if (wasTransfer)
        {
            form.SourceAccountId = string.Empty;
            form.DestinationAccountId = string.Empty;
        }

        saveErrors = [];
        ClearSuccess();
    }

    private void OnCategoryChanged()
    {
        form.SubcategoryId = string.Empty;
        ClearSuccess();
    }

    private void OnSourceChanged()
    {
        if (form.DestinationAccountId == form.SourceAccountId)
        {
            form.DestinationAccountId = string.Empty;
        }

        ClearSuccess();
    }

    private void ClearSuccess() => successMessage = null;

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return;
        }

        successMessage = null;
        saveErrors = [];

        if (!TryBuildRequest(out var request, out var errors))
        {
            saveErrors = errors;
            return;
        }

        isSaving = true;

        var result = await TransactionsApi.CreateTransactionAsync(request);

        if (result.IsSuccess)
        {
            var transaction = result.Value!;
            successMessage = $"{transaction.Type} of {transaction.Amount.ToString("0.00##", CultureInfo.CurrentCulture)} {transaction.Currency} saved.";

            // Keep type and account selection(s) for fast repeated entry; reset the rest.
            form.Amount = string.Empty;
            form.Note = string.Empty;
            form.CategoryId = string.Empty;
            form.SubcategoryId = string.Empty;
            form.OccurredAtLocal = CurrentLocalTime();
        }
        else
        {
            saveErrors = result.Errors;
        }

        isSaving = false;
    }

    // Lightweight client-side checks for usability; the API remains authoritative.
    private bool TryBuildRequest(out CreateTransactionRequest request, out IReadOnlyList<string> errors)
    {
        request = null!;
        var problems = new List<string>();

        if (!TryParseAmount(form.Amount, out var amount))
        {
            problems.Add("Enter an amount greater than zero, e.g. 12,50.");
        }

        if (!TryConvertToUtc(form.OccurredAtLocal, out var occurredAtUtc))
        {
            problems.Add("This local time does not exist (daylight saving change). Choose another time.");
        }

        var note = string.IsNullOrWhiteSpace(form.Note) ? null : form.Note.Trim();

        if (IsTransfer)
        {
            var hasSource = Guid.TryParse(form.SourceAccountId, out var sourceAccountId);
            var hasDestination = Guid.TryParse(form.DestinationAccountId, out var destinationAccountId);

            if (!hasSource)
            {
                problems.Add("Select the account to transfer from.");
            }

            if (!hasDestination)
            {
                problems.Add("Select the account to transfer to.");
            }

            if (problems.Count == 0)
            {
                request = new CreateTransactionRequest(
                    Transfer, amount, AccountId: null, sourceAccountId, destinationAccountId, CategoryId: null, occurredAtUtc, note);
            }
        }
        else
        {
            var hasAccount = Guid.TryParse(form.AccountId, out var accountId);
            var hasCategory = Guid.TryParse(form.CategoryId, out var categoryId);

            if (!hasAccount)
            {
                problems.Add("Select an account.");
            }

            if (!hasCategory)
            {
                problems.Add("Select a category.");
            }

            // A selected subcategory is sent instead of its parent; both are valid categories.
            if (Guid.TryParse(form.SubcategoryId, out var subcategoryId))
            {
                categoryId = subcategoryId;
            }

            if (problems.Count == 0)
            {
                request = new CreateTransactionRequest(
                    selectedType, amount, accountId, SourceAccountId: null, DestinationAccountId: null, categoryId, occurredAtUtc, note);
            }
        }

        errors = problems;
        return problems.Count == 0;
    }

    // Accepts "12,50" and "12.50" (one decimal separator, no thousands separators).
    private static bool TryParseAmount(string? text, out decimal amount)
    {
        amount = 0;

        if (string.IsNullOrWhiteSpace(text))
        {
            return false;
        }

        var normalized = text.Trim().Replace(',', '.');

        if (normalized.Count(character => character == '.') > 1)
        {
            return false;
        }

        return decimal.TryParse(normalized, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out amount)
            && amount > 0;
    }

    // datetime-local is a wall-clock time without a time zone: interpret it explicitly
    // in the device's local time zone and convert it to UTC for the API.
    private static bool TryConvertToUtc(DateTime localWallClock, out DateTimeOffset occurredAtUtc)
    {
        occurredAtUtc = default;
        var unspecified = DateTime.SpecifyKind(localWallClock, DateTimeKind.Unspecified);

        if (TimeZoneInfo.Local.IsInvalidTime(unspecified))
        {
            return false;
        }

        var utc = TimeZoneInfo.ConvertTimeToUtc(unspecified, TimeZoneInfo.Local);
        occurredAtUtc = new DateTimeOffset(utc, TimeSpan.Zero);

        return true;
    }

    private static DateTime CurrentLocalTime()
    {
        var now = DateTime.Now;

        return new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0, DateTimeKind.Unspecified);
    }

    private AccountResponse? FindAccount(string? id) =>
        Guid.TryParse(id, out var accountId)
            ? accounts.FirstOrDefault(account => account.Id == accountId)
            : null;

    private sealed class TransactionForm
    {
        public string Amount { get; set; } = string.Empty;

        public string AccountId { get; set; } = string.Empty;

        public string SourceAccountId { get; set; } = string.Empty;

        public string DestinationAccountId { get; set; } = string.Empty;

        public string CategoryId { get; set; } = string.Empty;

        public string SubcategoryId { get; set; } = string.Empty;

        public DateTime OccurredAtLocal { get; set; } = CurrentLocalTime();

        public string Note { get; set; } = string.Empty;
    }
}
