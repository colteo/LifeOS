@page "/"
@using System.Globalization
@inject AuthService Auth
@inject AccountsApiClient AccountsApi
@inject CategoriesApiClient CategoriesApi
@inject TransactionsApiClient TransactionsApi

@* Home: how much the user has (per currency, never summed across currencies) and what happened
   recently. Both sections load and fail independently. *@

<h1 class="h3 mb-4">@(Auth.CurrentUser?.DisplayName is { Length: > 0 } name ? $"Ciao, {name}" : "LifeOS")</h1>

<section class="mb-4">
	<h2 class="h5">Patrimonio</h2>

	@if (isLoading && portfolio is null)
	{
		<p class="text-muted"><em>Caricamento...</em></p>
	}
	else if (portfolioError)
	{
		<div class="alert alert-warning d-flex justify-content-between align-items-center gap-2" role="alert">
			<span>Impossibile caricare il patrimonio.</span>
			<button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">Riprova</button>
		</div>
	}
	else if (portfolio is { Count: 0 })
	{
		<p class="text-muted">Nessun conto disponibile.</p>
	}
	else if (portfolio is not null)
	{
		@* Signed net amounts (a credit-card debt reduces its currency), in neutral styling. *@
		<ul class="list-group">
			@foreach (var currency in portfolio)
			{
				<li class="list-group-item d-flex justify-content-between align-items-baseline gap-3">
					<div>
						<span class="fw-semibold">@currency.Currency</span>
						@if (currency.Status == PortfolioStatus.Partial)
						{
							<div class="text-muted small">@UnavailableLabel(currency.UnavailableCount)</div>
						}
					</div>
					<div class="text-end text-nowrap">
						@switch (currency.Status)
						{
							case PortfolioStatus.Unavailable:
								<span class="text-muted small">Saldo non disponibile</span>
								break;

							case PortfolioStatus.Partial:
								<span class="text-muted small me-1">Parziale</span>
								<span>@FormatAmount(currency.KnownTotal, currency.Currency)</span>
								break;

							default:
								<span>@FormatAmount(currency.KnownTotal, currency.Currency)</span>
								break;
						}
					</div>
				</li>
			}
		</ul>
	}
</section>

<section>
	<h2 class="h5">Ultime transazioni</h2>

	@if (isLoading && recent is null)
	{
		<p class="text-muted"><em>Caricamento...</em></p>
	}
	else if (recentError)
	{
		<div class="alert alert-warning d-flex justify-content-between align-items-center gap-2" role="alert">
			<span>Impossibile caricare le transazioni.</span>
			<button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">Riprova</button>
		</div>
	}
	else if (recent is { Count: 0 })
	{
		<p class="text-muted">Nessuna transazione recente.</p>
	}
	else if (recent is not null)
	{
		<ul class="list-group">
			@foreach (var transaction in recent)
			{
				<li class="list-group-item">
					<div class="d-flex justify-content-between align-items-baseline gap-3">
						<span class="fw-semibold text-truncate home-row-title">@Title(transaction)</span>
						<span class="text-nowrap @TransactionDisplay.AmountCssClass(transaction)">@TransactionDisplay.AmountText(transaction)</span>
					</div>
					<div class="text-muted small text-truncate">@Details(transaction)</div>
					<div class="text-muted small">@TransactionDisplay.CompactDateTime(transaction.OccurredAtUtc, DateTime.Today, TimeZoneInfo.Local, CultureInfo.CurrentCulture)</div>
				</li>
			}
		</ul>
	}

	<a href="finance/transactions" class="btn btn-link px-0 mt-2">Vedi tutte</a>
</section>

@code {
	private const int RecentCount = 5;

	private IReadOnlyList<CurrencyPortfolio>? portfolio;
	private IReadOnlyList<TransactionResponse>? recent;
	private IReadOnlyList<AccountResponse> accounts = [];
	private IReadOnlyList<CategoryResponse> categories = [];
	private bool portfolioError;
	private bool recentError;
	private bool isLoading = true;

	// Only the latest load may update the page.
	private int loadVersion;

	protected override Task OnInitializedAsync() => LoadAsync();

	private async Task LoadAsync()
	{
		var version = ++loadVersion;
		isLoading = true;

		var balancesTask = AccountsApi.GetBalancesAsync();
		var accountsTask = AccountsApi.GetAccountsAsync();
		var categoriesTask = CategoriesApi.GetCategoriesAsync();
		var recentTask = TransactionsApi.GetRecentTransactionsAsync(RecentCount);
		await Task.WhenAll(balancesTask, accountsTask, categoriesTask, recentTask);

		if (version != loadVersion)
		{
			return;
		}

		// Each section succeeds or fails on its own.
		portfolioError = !balancesTask.Result.IsSuccess;
		portfolio = balancesTask.Result.IsSuccess
			? PortfolioSummary.Build(balancesTask.Result.Value!, Auth.CurrentUser?.DefaultCurrency)
			: null;

		recentError = !recentTask.Result.IsSuccess;
		recent = recentTask.Result.IsSuccess ? recentTask.Result.Value! : null;

		// Names only: when they cannot be loaded, rows still render with fallback labels.
		accounts = accountsTask.Result.IsSuccess ? accountsTask.Result.Value! : [];
		categories = categoriesTask.Result.IsSuccess ? categoriesTask.Result.Value! : [];

		isLoading = false;
	}

	// Income/Expense: the note when present, otherwise the category. Transfers: a neutral label.
	private string Title(TransactionResponse transaction) =>
		transaction.Type == TransactionDisplay.Transfer ? "⇄ Trasferimento"
		: Note(transaction) ?? CategoryLabel(transaction.CategoryId);

	// The category is repeated here only when the note took the title.
	private string Details(TransactionResponse transaction) =>
		transaction.Type == TransactionDisplay.Transfer
			? $"{AccountName(transaction.SourceAccountId)} → {AccountName(transaction.DestinationAccountId)}"
			: Note(transaction) is null
				? AccountName(transaction.AccountId)
				: $"{CategoryLabel(transaction.CategoryId)} · {AccountName(transaction.AccountId)}";

	private static string? Note(TransactionResponse transaction) =>
		string.IsNullOrWhiteSpace(transaction.Note) ? null : transaction.Note.Trim();

	private string CategoryLabel(Guid? categoryId) =>
		TransactionDisplay.CategoryLabel(categories, categoryId) ?? "Categoria sconosciuta";

	private string AccountName(Guid? accountId) =>
		TransactionDisplay.AccountName(accounts, accountId) ?? "Conto sconosciuto";

	private static string FormatAmount(decimal amount, string currency) =>
		$"{amount.ToString("#,##0.00##", CultureInfo.CurrentCulture)} {currency}";

	private static string UnavailableLabel(int count) =>
		count == 1 ? "1 saldo non disponibile" : $"{count} saldi non disponibili";
}
