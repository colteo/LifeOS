@page "/"
@inject AuthService Auth

@* Home: what matters now in LifeOS, one section per domain. Each module contributes a self-contained
   summary that loads and fails on its own, so one module's failure never hides another's. A new
   module adds its HomeSection here. *@

<div class="lo-page-header">
	<h1 class="lo-page-title">@(Auth.CurrentUser?.DisplayName is { Length: > 0 } name ? $"Hi, {name}" : "LifeOS")</h1>
</div>

<HomeSection Title="Today">
	<GymHomeSummary />
</HomeSection>

<HomeSection Title="Finance" Href="finance" LinkLabel="Finance" LinkAriaLabel="Open Finance">
	<FinanceHomeSummary />
</HomeSection>

<HomeSection Title="Recent activity" Href="finance/transactions" LinkLabel="View all" LinkAriaLabel="View all transactions">
	<RecentTransactionsSummary />
</HomeSection>
