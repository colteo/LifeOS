@page "/"
@inject AuthService Auth

@* Home (APP-001): only the monthly budget, with the way into Portfolio and Analytics, and training.
   Each card loads and fails on its own; Home does not try to represent every module (that is More). *@

<div class="lo-page-header">
	<h1 class="lo-page-title">@(Auth.CurrentUser?.DisplayName is { Length: > 0 } name ? $"Hi, {name}" : "LifeOS")</h1>
</div>

<section class="lo-section">
	<MonthlyBudgetCard Currency="@(Auth.CurrentUser?.DefaultCurrency)">
		<Actions>
			<a href="portfolio" class="btn btn-outline-secondary lo-home-action">
				<AppIcon Name="wallet" Size="18" />
				<span>Portfolio</span>
			</a>
			<a href="finance/analytics" class="btn btn-outline-secondary lo-home-action">
				<AppIcon Name="chart" Size="18" />
				<span>Analytics</span>
			</a>
		</Actions>
	</MonthlyBudgetCard>
</section>

<section class="lo-section">
	<HomeTrainingCard />
</section>
