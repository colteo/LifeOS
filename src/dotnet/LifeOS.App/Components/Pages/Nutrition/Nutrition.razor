@page "/nutrition"
@inject NutritionApiClient NutritionApi

@* The meal journal (NUT-001): one diary day at a time, newest meal first. Each meal is one free-text
   entry; the meal type is an optional label and never groups or orders the list. The add form and
   each meal's ⋮ panel (Edit, Delete) open inline, one at a time.

   NUT-002 adds optional AI nutrition. Adding or editing a meal never calls AI. A meal's Estimate shows
   a proposal inline (Confirm / Edit / Cancel); nothing is stored until Confirm or Edit. Daily totals
   come from the API (sums of stored meal nutrition) and are always shown with "N meals · M analyzed".

   NUT-003: the day's totals compare with the target the API resolved for that date ("1480 / 2200 kcal");
   untargeted metrics show only the value. The Target section shows that resolved target and, when a
   period covers the day, "Edit for this day" (a custom target or no target for this date only); removing
   the override returns the day to its weekday rule.

   Information architecture: this page is operational and contextual. Its actions concern the selected
   day only (meals, Estimate/Analyze, "Edit for this day"). Target periods are module configuration,
   managed on Nutrition > Targets and reached from the Nutrition hub, never from here. *@

<PageHeader Title="Food diary" BackHref="nutrition/hub" />

<div class="d-flex align-items-center justify-content-between mb-2">
	<button type="button" class="lo-icon-btn lo-icon-btn--outlined" aria-label="Previous day" disabled="@isSaving" @onclick="() => ChangeDayAsync(-1)">
		<AppIcon Name="chevron-left" Size="20" />
	</button>
	<h2 class="lo-section-title" aria-live="polite">@MealJournal.DayLabel(selectedDay, Today)</h2>
	<button type="button" class="lo-icon-btn lo-icon-btn--outlined" aria-label="Next day"
			disabled="@(isSaving || !MealJournal.CanGoForward(selectedDay, Today))" @onclick="() => ChangeDayAsync(1)">
		<AppIcon Name="chevron-right" Size="20" />
	</button>
</div>

@if (!hasLoaded && isLoading)
{
	<p class="lo-muted"><em>Loading meals...</em></p>
}
else if (!hasLoaded && loadError is not null)
{
	<div class="alert alert-danger d-flex justify-content-between align-items-center gap-2" role="alert">
		<span>@loadError</span>
		<button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">Retry</button>
	</div>
}
else
{
	@if (loadError is not null)
	{
		@* A reload failed: the previously loaded day is kept. *@
		<div class="alert alert-warning d-flex justify-content-between align-items-center gap-2" role="alert">
			<span>@loadError</span>
			<button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">Retry</button>
		</div>
	}

	<div class="lo-section-header">
		<h2 class="lo-section-title">Daily nutrition</h2>
		@if (summary is not null && NutritionDisplay.AnalyzeLabel(summary, isToday: false) is { } analyzeLabel)
		{
			<button type="button" class="lo-header-action" disabled="@(analyzing || isSaving)" @onclick="AnalyzeDayAsync">
				@(analyzing ? "Analyzing..." : analyzeLabel)
			</button>
		}
	</div>

	<div class="lo-card p-3 mb-3" aria-live="polite">
		@if (summary is null)
		{
			@if (summaryError is not null)
			{
				<div class="d-flex justify-content-between align-items-center gap-2" role="alert">
					<span class="text-danger">@summaryError</span>
					<button class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="LoadAsync" disabled="@isLoading">Retry</button>
				</div>
			}
			else
			{
				<p class="lo-muted mb-0">Loading nutrition...</p>
			}
		}
		else
		{
			<div class="@(NutritionDisplay.ShowsTotals(summary) ? "lo-muted small" : null)">@NutritionDisplay.CountLine(summary)</div>
			@if (NutritionDisplay.ShowsTotals(summary))
			{
				@if (summary.Target is { } dayTarget)
				{
					<div class="nutrition-total">@NutritionTargetDisplay.KcalLine(summary.CaloriesKcal, dayTarget.CaloriesKcal)</div>
					<dl class="target-comparison small mb-0">
						<dt>Protein</dt><dd>@NutritionTargetDisplay.GramsLine(summary.ProteinGrams, dayTarget.ProteinGrams)</dd>
						<dt>Carbs</dt><dd>@NutritionTargetDisplay.GramsLine(summary.CarbsGrams, dayTarget.CarbsGrams)</dd>
						<dt>Fat</dt><dd>@NutritionTargetDisplay.GramsLine(summary.FatGrams, dayTarget.FatGrams)</dd>
					</dl>
				}
				else
				{
					<div class="nutrition-total">@NutritionDisplay.Kcal(summary.CaloriesKcal)</div>
					<div class="lo-muted small">@NutritionDisplay.Macros(summary.ProteinGrams, summary.CarbsGrams, summary.FatGrams)</div>
				}
			}
		}

		@if (analyzeMessage is not null)
		{
			<div class="alert alert-warning mt-2 mb-0 py-2 small" role="alert">@analyzeMessage</div>
		}
	</div>

	@DayTarget()

	<div class="lo-section-header">
		<h2 class="lo-section-title">Meals</h2>
		<button type="button" class="lo-header-action" aria-expanded="@(adding ? "true" : "false")" aria-controls="add-meal-form"
				disabled="@isSaving" @onclick="ToggleAdd">
			<AppIcon Name="plus" Size="18" StrokeWidth="2.2" />
			Add meal
		</button>
	</div>

	<div class="lo-card">
		@if (adding)
		{
			<div id="add-meal-form" class="pt-2">
				@MealForm("Add meal", "Adding...", AddAsync)
			</div>
		}

		@if (meals.Count == 0)
		{
			@if (!adding)
			{
				<p class="lo-empty">@MealJournal.EmptyMessage(selectedDay, Today)</p>
			}
		}
		else
		{
			<ul class="lo-list">
				@foreach (var meal in meals)
				{
					<li>
						<div class="lo-row">
							<div class="lo-row__main">
								<span class="lo-row__title d-block">@MealJournal.Heading(meal)</span>
								<span class="meal-description d-block">@meal.Description</span>
								@MealNutrition(meal)
							</div>
							<button type="button"
									class="lo-icon-btn"
									aria-label="Actions for the @MealJournal.TimeText(meal.Time) meal"
									aria-expanded="@(IsActionOpen(meal.Id) ? "true" : "false")"
									disabled="@isSaving"
									@onclick="() => ToggleActions(meal)"><AppIcon Name="more-vertical" /></button>
						</div>

						@if (IsActionOpen(meal.Id))
						{
							@ActionPanel(meal)
						}
					</li>
				}
			</ul>
		}
	</div>
}

@code {
	private DateOnly selectedDay = MealJournal.Today(DateTime.Now);
	private IReadOnlyList<MealResponse> meals = [];
	private bool hasLoaded;
	private bool isLoading = true;
	private string? loadError;

	// The day's totals, from the API; loaded with the meals but failing on their own.
	private DailyNutritionSummaryResponse? summary;
	private string? summaryError;
	private bool analyzing;
	private string? analyzeMessage;

	// Only the latest load may update the page.
	private int loadVersion;

	// The one form or panel open on the page: the add form, or one meal's panel.
	private bool adding;
	private MealResponse? actionTarget;
	private ActionPanelKind actionPanel;
	private string formDescription = string.Empty;
	private string formMealType = string.Empty;
	private TimeOnly? formTime;
	private IReadOnlyList<string> formErrors = [];
	private bool isSaving;

	// An AI proposal for actionTarget (never stored until Confirm or Edit), and the nutrition form.
	private NutritionEstimateResponse? proposal;
	private bool estimating;
	private int estimateVersion;
	private decimal? formKcal;
	private decimal? formProtein;
	private decimal? formCarbs;
	private decimal? formFat;

	// NUT-003: the target resolved for the selected day (loaded with the meals, failing on its own) and
	// the "Edit for this day" override editor.
	private ResolvedNutritionTargetResponse? resolved;
	private string? resolvedError;
	private bool editingOverride;
	private string overrideMode = NutritionTargetDisplay.Custom;
	private TargetFields overrideFields = new();
	private IReadOnlyList<string> overrideErrors = [];
	private bool overrideSaving;

	private static DateOnly Today => MealJournal.Today(DateTime.Now);

	protected override Task OnInitializedAsync() => LoadAsync();

	private async Task LoadAsync()
	{
		var version = ++loadVersion;
		var day = selectedDay;
		isLoading = true;

		var mealsTask = NutritionApi.GetMealsAsync(day);
		var summaryTask = NutritionApi.GetSummaryAsync(day);
		var resolvedTask = NutritionApi.GetResolvedTargetAsync(day);
		var result = await mealsTask;
		var totals = await summaryTask;
		var target = await resolvedTask;

		if (version != loadVersion)
		{
			return;
		}

		if (result.IsSuccess)
		{
			meals = MealJournal.NewestFirst(result.Value!);
			hasLoaded = true;
			loadError = null;
		}
		else
		{
			loadError = string.Join(" ", result.Errors);
		}

		summary = totals.IsSuccess ? totals.Value : null;
		summaryError = totals.IsSuccess ? null : string.Join(" ", totals.Errors);
		resolved = target.IsSuccess ? target.Value : null;
		resolvedError = target.IsSuccess ? null : string.Join(" ", target.Errors);
		isLoading = false;
	}

	// Another day: nothing of the previous day (list, form, panel) stays on screen.
	private async Task ChangeDayAsync(int days)
	{
		var day = selectedDay.AddDays(days);

		if (isSaving || (days > 0 && !MealJournal.CanGoForward(selectedDay, Today)))
		{
			return;
		}

		Close();
		selectedDay = day;
		meals = [];
		summary = null;
		summaryError = null;
		resolved = null;
		resolvedError = null;
		CloseOverride();
		analyzeMessage = null;
		hasLoaded = false;
		loadError = null;
		await LoadAsync();
	}

	private bool IsActionOpen(Guid mealId) => actionTarget?.Id == mealId;

	// "+ Add meal" toggles the add form. The diary day is the one on screen.
	private void ToggleAdd()
	{
		if (isSaving)
		{
			return;
		}

		var wasAdding = adding;
		Close();

		if (!wasAdding)
		{
			adding = true;
			formTime = MealJournal.DefaultTime(selectedDay, DateTime.Now);
		}
	}

	// ⋮ toggles the meal's action panel (Edit, Edit nutrition, Delete); it also closes a proposal.
	private void ToggleActions(MealResponse meal)
	{
		if (isSaving)
		{
			return;
		}

		var wasOpen = IsActionOpen(meal.Id);
		Close();

		if (!wasOpen)
		{
			actionTarget = meal;
			actionPanel = ActionPanelKind.Actions;
		}
	}

	private void ShowEdit()
	{
		if (actionTarget is not { } meal)
		{
			return;
		}

		formDescription = meal.Description;
		formMealType = meal.MealType ?? string.Empty;
		formTime = meal.Time;
		formErrors = [];
		actionPanel = ActionPanelKind.Edit;
	}

	private void ShowConfirmDelete()
	{
		formErrors = [];
		actionPanel = ActionPanelKind.ConfirmDelete;
	}

	// Edit nutrition: from the stored values (⋮) or from the proposal (Edit). Saved as Adjusted.
	private void ShowEditNutrition()
	{
		if (actionTarget is not { } meal)
		{
			return;
		}

		var values = proposal is { } estimate
			? (estimate.CaloriesKcal, estimate.ProteinGrams, estimate.CarbsGrams, estimate.FatGrams)
			: meal.Nutrition is { } stored
				? (stored.CaloriesKcal, stored.ProteinGrams, stored.CarbsGrams, stored.FatGrams)
				: (0m, 0m, 0m, 0m);

		(formKcal, formProtein, formCarbs, formFat) = values;
		formErrors = [];
		actionPanel = ActionPanelKind.EditNutrition;
	}

	private void Close()
	{
		adding = false;
		actionTarget = null;
		formDescription = string.Empty;
		formMealType = string.Empty;
		formTime = null;
		formErrors = [];
		proposal = null;
		estimating = false;
		estimateVersion++;
	}

	// Convenience checks only; the API validates everything.
	private bool TryReadForm(out TimeOnly time)
	{
		time = formTime ?? default;
		var errors = new List<string>();

		if (string.IsNullOrWhiteSpace(formDescription))
		{
			errors.Add("Describe what you ate.");
		}

		if (formTime is null)
		{
			errors.Add("Enter a time.");
		}

		formErrors = errors;

		return errors.Count == 0;
	}

	private async Task AddAsync()
	{
		if (isSaving || !adding || !TryReadForm(out var time))
		{
			return;
		}

		isSaving = true;

		var result = await NutritionApi.CreateMealAsync(
			MealJournal.CreateRequest(formDescription, formMealType, selectedDay, time, TimeZoneInfo.Local));

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	// The meal stays on this day; only its text, type and time change. A new description on a meal with
	// nutrition first asks to confirm that the nutrition will be cleared.
	private async Task EditAsync()
	{
		if (isSaving || actionTarget is not { } meal || !TryReadForm(out var time))
		{
			return;
		}

		if (meal.Nutrition is not null && NutritionDisplay.DescriptionChanged(meal.Description, formDescription)
			&& actionPanel != ActionPanelKind.ConfirmClearNutrition)
		{
			actionPanel = ActionPanelKind.ConfirmClearNutrition;
			return;
		}

		isSaving = true;

		var result = await NutritionApi.UpdateMealAsync(meal.Id,
			MealJournal.UpdateRequest(formDescription, formMealType, time, clearNutrition: actionPanel == ActionPanelKind.ConfirmClearNutrition));

		// Analyzed meanwhile (e.g. by Analyze day): ask before clearing that nutrition.
		if (!result.IsSuccess && result.Errors.SequenceEqual([NutritionApiClient.NutritionClearRequiredMessage]))
		{
			isSaving = false;
			formErrors = [];
			actionPanel = ActionPanelKind.ConfirmClearNutrition;
			return;
		}

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	private async Task DeleteAsync()
	{
		if (isSaving || actionTarget is not { } meal)
		{
			return;
		}

		isSaving = true;
		formErrors = [];

		var result = await NutritionApi.DeleteMealAsync(meal.Id);

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	// Estimate / Re-estimate: a proposal for this meal only, shown inline. Nothing is stored.
	private async Task EstimateAsync(MealResponse meal)
	{
		if (isSaving || estimating)
		{
			return;
		}

		Close();
		actionTarget = meal;
		actionPanel = ActionPanelKind.Proposal;
		estimating = true;
		var version = estimateVersion;

		var result = await NutritionApi.EstimateAsync(meal.Id);

		// Cancelled, or another panel opened meanwhile: the answer is dropped.
		if (version != estimateVersion)
		{
			return;
		}

		estimating = false;
		proposal = result.IsSuccess ? result.Value : null;
		formErrors = result.Errors;
	}

	// Confirm: the proposal unchanged, as a confirmed estimate.
	private async Task ConfirmProposalAsync()
	{
		if (isSaving || actionTarget is not { } meal || proposal is not { } estimate)
		{
			return;
		}

		isSaving = true;

		var result = await NutritionApi.SetNutritionAsync(meal.Id, NutritionDisplay.Confirm(estimate));

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	private async Task SaveNutritionAsync()
	{
		if (isSaving || actionTarget is not { } meal)
		{
			return;
		}

		if (formKcal is not { } kcal || formProtein is not { } protein || formCarbs is not { } carbs || formFat is not { } fat
			|| kcal < 0 || protein < 0 || carbs < 0 || fat < 0)
		{
			formErrors = ["Enter kcal, protein, carbs and fat (0 or more)."];
			return;
		}

		isSaving = true;

		var result = await NutritionApi.SetNutritionAsync(meal.Id, NutritionDisplay.Adjusted(kcal, protein, carbs, fat));

		await FinishAsync(result.IsSuccess, result.Errors);
	}

	// Analyze day / Analyze remaining: only meals without nutrition; successes are kept even when
	// another meal fails.
	private async Task AnalyzeDayAsync()
	{
		if (analyzing || isSaving)
		{
			return;
		}

		var day = selectedDay;
		analyzing = true;
		analyzeMessage = null;

		var result = await NutritionApi.AnalyzeDayAsync(day);

		analyzing = false;

		if (day != selectedDay)
		{
			return;
		}

		analyzeMessage = result.IsSuccess ? NutritionDisplay.AnalysisMessage(result.Value!) : string.Join(" ", result.Errors);
		await LoadAsync();
	}

	// "Edit for this day": starts from the current override, otherwise a custom target prefilled with the
	// day's resolved target.
	private void ShowOverride()
	{
		if (resolved is not { CoveredByPlan: true } day)
		{
			return;
		}

		overrideMode = day.Override?.Mode ?? NutritionTargetDisplay.Custom;
		overrideFields = TargetFields.From(day.Override?.Target ?? day.Target);
		overrideErrors = [];
		editingOverride = true;
	}

	private void CloseOverride()
	{
		editingOverride = false;
		overrideErrors = [];
	}

	private async Task SaveOverrideAsync()
	{
		if (overrideSaving)
		{
			return;
		}

		var custom = overrideMode == NutritionTargetDisplay.Custom;

		if (custom && overrideFields.IsEmpty)
		{
			overrideErrors = ["Enter at least one target, or choose No target for this day."];
			return;
		}

		if (custom && overrideFields.HasNonPositive)
		{
			overrideErrors = ["Targets must be more than 0."];
			return;
		}

		overrideSaving = true;

		var day = selectedDay;
		var result = await NutritionApi.SetTargetOverrideAsync(day,
			new NutritionTargetOverrideDto(overrideMode, custom ? overrideFields.ToDto() : null));

		await FinishOverrideAsync(day, result.IsSuccess, result.Errors);
	}

	// Back to the period's weekday rule.
	private async Task RemoveOverrideAsync()
	{
		if (overrideSaving)
		{
			return;
		}

		overrideSaving = true;

		var day = selectedDay;
		var result = await NutritionApi.RemoveTargetOverrideAsync(day);

		await FinishOverrideAsync(day, result.IsSuccess, result.Errors);
	}

	// The day's comparison changes with its target, so the day reloads.
	private async Task FinishOverrideAsync(DateOnly day, bool succeeded, IReadOnlyList<string> errors)
	{
		overrideSaving = false;

		if (day != selectedDay)
		{
			return;
		}

		if (!succeeded)
		{
			overrideErrors = errors;
			return;
		}

		CloseOverride();
		await LoadAsync();
	}

	// On success the form or panel closes and the day reloads in the API's order; on failure it stays
	// open with the reason and the typed text.
	private async Task FinishAsync(bool succeeded, IReadOnlyList<string> errors)
	{
		if (succeeded)
		{
			Close();
			isSaving = false;
			await LoadAsync();
			return;
		}

		formErrors = errors;
		isSaving = false;
	}

	// Secondary to the description: kcal, macros and provenance, or "Not analyzed", with the AI action.
	private RenderFragment MealNutrition(MealResponse meal) =>
		@<div class="meal-nutrition">
			<div class="meal-nutrition__values">
				@if (meal.Nutrition is { } nutrition)
				{
					<span class="d-block">@NutritionDisplay.Kcal(nutrition)</span>
					<span class="d-block lo-muted small">@NutritionDisplay.Macros(nutrition)</span>
					<span class="d-block lo-muted small">@NutritionDisplay.SourceLabel(nutrition.Source)</span>
				}
				else
				{
					<span class="lo-muted small">Not analyzed</span>
				}
			</div>
			<button type="button" class="btn btn-outline-secondary btn-sm meal-nutrition__action"
					aria-label="@(meal.Nutrition is null ? "Estimate" : "Re-estimate") the @MealJournal.TimeText(meal.Time) meal"
					disabled="@(isSaving || estimating || analyzing)" @onclick="() => EstimateAsync(meal)">
				@(meal.Nutrition is null ? "Estimate" : "Re-estimate")
			</button>
		</div>;

	private RenderFragment ActionPanel(MealResponse meal) =>
		@<div class="lo-panel">
			@switch (actionPanel)
			{
				case ActionPanelKind.Edit:
					@MealForm("Save", "Saving...", EditAsync)
					break;

				case ActionPanelKind.ConfirmClearNutrition:
					<p class="small mb-2">@NutritionApiClient.NutritionClearRequiredMessage</p>
					@FormErrors()
					<div class="d-flex gap-2 mt-2">
						<button type="button" class="btn btn-primary btn-sm" disabled="@isSaving" @onclick="EditAsync">@(isSaving ? "Saving..." : "Save and clear")</button>
						<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="() => actionPanel = ActionPanelKind.Edit">Back</button>
					</div>
					break;

				case ActionPanelKind.ConfirmDelete:
					<p class="small mb-2">Delete the <span class="fw-semibold">@MealJournal.TimeText(meal.Time)</span> meal? This can't be undone.</p>
					@FormErrors()
					<div class="d-flex gap-2 mt-2">
						<button type="button" class="btn btn-danger btn-sm" disabled="@isSaving" @onclick="DeleteAsync">@(isSaving ? "Deleting..." : "Delete")</button>
						<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="Close">Cancel</button>
					</div>
					break;

				case ActionPanelKind.Proposal:
					@ProposalPanel()
					break;

				case ActionPanelKind.EditNutrition:
					@NutritionForm()
					break;

				default:
					<div class="d-flex flex-column align-items-start">
						<button type="button" class="btn btn-link btn-sm px-0" @onclick="ShowEdit">Edit</button>
						@if (meal.Nutrition is not null)
						{
							<button type="button" class="btn btn-link btn-sm px-0" @onclick="ShowEditNutrition">Edit nutrition</button>
						}
						<button type="button" class="btn btn-link btn-sm px-0 text-danger" @onclick="ShowConfirmDelete">Delete</button>
					</div>
					break;
			}
		</div>;

	private RenderFragment ProposalPanel() =>
		@<div aria-live="polite">
			@if (estimating)
			{
				<p class="lo-muted small mb-0">Estimating...</p>
			}
			else if (proposal is { } estimate)
			{
				<p class="lo-muted small mb-1">AI estimate</p>
				<div class="nutrition-total">@NutritionDisplay.Kcal(estimate.CaloriesKcal)</div>
				<div class="lo-muted small">@NutritionDisplay.Macros(estimate.ProteinGrams, estimate.CarbsGrams, estimate.FatGrams)</div>
				@if (estimate.Assumptions.Count > 0)
				{
					<p class="lo-muted small mt-2 mb-1">Based on</p>
					<ul class="proposal-assumptions small mb-0">
						@foreach (var assumption in estimate.Assumptions)
						{
							<li>@assumption</li>
						}
					</ul>
				}
				@FormErrors()
				<div class="d-flex gap-2 mt-2">
					<button type="button" class="btn btn-primary btn-sm" disabled="@isSaving" @onclick="ConfirmProposalAsync">@(isSaving ? "Saving..." : "Confirm")</button>
					<button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isSaving" @onclick="ShowEditNutrition">Edit</button>
					<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="Close">Cancel</button>
				</div>
			}
			else
			{
				@* The estimate failed; the meal and any stored nutrition are untouched. *@
				@FormErrors()
				<div class="d-flex gap-2 mt-2">
					<button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => EstimateAsync(actionTarget!)">Retry</button>
					<button type="button" class="btn btn-link btn-sm" @onclick="Close">Cancel</button>
				</div>
			}
		</div>;

	// kcal and grams; saved as "Adjusted". Never calls AI.
	private RenderFragment NutritionForm() =>
		@<form @onsubmit="SaveNutritionAsync" @onsubmit:preventDefault="true">
			<div class="nutrition-fields">
				<div>
					<label for="nutrition-kcal" class="form-label small">kcal</label>
					<input id="nutrition-kcal" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="formKcal" />
				</div>
				<div>
					<label for="nutrition-protein" class="form-label small">Protein g</label>
					<input id="nutrition-protein" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="formProtein" />
				</div>
				<div>
					<label for="nutrition-carbs" class="form-label small">Carbs g</label>
					<input id="nutrition-carbs" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="formCarbs" />
				</div>
				<div>
					<label for="nutrition-fat" class="form-label small">Fat g</label>
					<input id="nutrition-fat" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="formFat" />
				</div>
			</div>

			@FormErrors()

			<div class="d-flex gap-2 mt-2">
				<button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">@(isSaving ? "Saving..." : "Save")</button>
				<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="Close">Cancel</button>
			</div>
		</form>;

	// The add form (inside the card) and the edit form (inside a meal's panel) are the same fields.
	private RenderFragment MealForm(string submitLabel, string busyLabel, Func<Task> submit) =>
		@<form class="@(adding ? "lo-panel mt-1" : null)" @onsubmit="submit" @onsubmit:preventDefault="true">
			<label for="meal-description" class="form-label small">What did you eat?</label>
			<textarea id="meal-description" class="form-control" rows="3" maxlength="2000" @bind="formDescription" @bind:event="oninput"></textarea>

			<div class="d-flex gap-2 mt-2">
				<div class="flex-grow-1">
					<label for="meal-type" class="form-label small">Meal type</label>
					<select id="meal-type" class="form-select" @bind="formMealType">
						<option value="">Optional</option>
						@foreach (var type in MealJournal.MealTypes)
						{
							<option value="@type">@type</option>
						}
					</select>
				</div>
				<div class="meal-time">
					<label for="meal-time" class="form-label small">Time</label>
					<input id="meal-time" type="time" class="form-control" @bind="formTime" />
				</div>
			</div>

			@FormErrors()

			<div class="d-flex gap-2 mt-2">
				<button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">@(isSaving ? busyLabel : submitLabel)</button>
				<button type="button" class="btn btn-link btn-sm" disabled="@isSaving" @onclick="Close">Cancel</button>
			</div>
		</form>;

	// The selected day's resolved target and its per-day override actions. Nothing about target periods.
	private RenderFragment DayTarget() =>
		@<text>
			<div class="lo-section-header">
				<h2 class="lo-section-title">@(resolved?.Override is null ? "Target" : "Target override")</h2>
				@if (resolved is { CoveredByPlan: true } && !editingOverride)
				{
					<button type="button" class="lo-header-action" disabled="@overrideSaving" @onclick="ShowOverride">
						@(resolved.Override is null ? "Edit for this day" : "Edit")
					</button>
				}
			</div>

			<div class="lo-card p-3 mb-3">
				@if (resolved is null)
				{
					@if (resolvedError is not null)
					{
						<div class="d-flex justify-content-between align-items-center gap-2" role="alert">
							<span class="text-danger">@resolvedError</span>
							<button class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="LoadAsync" disabled="@isLoading">Retry</button>
						</div>
					}
					else
					{
						<p class="lo-muted mb-0">Loading target...</p>
					}
				}
				else if (!resolved.CoveredByPlan)
				{
					<p class="lo-muted mb-0">@NutritionTargetDisplay.NoTargetForDay</p>
				}
				else if (editingOverride)
				{
					@OverrideForm()
				}
				else
				{
					@if (resolved.Target is { } target)
					{
						@if (NutritionTargetDisplay.Kcal(target) is { } kcal)
						{
							<div class="nutrition-total">@kcal</div>
						}
						@if (NutritionTargetDisplay.Macros(target) is { } macros)
						{
							<div>@macros</div>
						}
					}
					else
					{
						<p class="lo-muted mb-0">@NutritionTargetDisplay.NoTargetForDay</p>
					}

					@if (resolved.Override is not null)
					{
						@OverrideErrors()
						<button type="button" class="btn btn-link btn-sm px-0 mt-1" disabled="@overrideSaving" @onclick="RemoveOverrideAsync">
							@(overrideSaving ? "Removing..." : "Remove override")
						</button>
					}
				}
			</div>
		</text>;

	// A custom target or no target for this date only.
	private RenderFragment OverrideForm() =>
		@<form @onsubmit="SaveOverrideAsync" @onsubmit:preventDefault="true">
			<div class="d-flex flex-column gap-1">
				<label class="form-check">
					<input class="form-check-input" type="radio" name="override-mode" checked="@(overrideMode == NutritionTargetDisplay.Custom)"
						   @onchange="() => overrideMode = NutritionTargetDisplay.Custom" />
					<span class="form-check-label">Use custom target</span>
				</label>
				<label class="form-check">
					<input class="form-check-input" type="radio" name="override-mode" checked="@(overrideMode == NutritionTargetDisplay.NoTarget)"
						   @onchange="() => overrideMode = NutritionTargetDisplay.NoTarget" />
					<span class="form-check-label">No target for this day</span>
				</label>
			</div>

			@if (overrideMode == NutritionTargetDisplay.Custom)
			{
				<div class="nutrition-fields mt-2">
					<div>
						<label for="override-kcal" class="form-label small">kcal</label>
						<input id="override-kcal" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="overrideFields.CaloriesKcal" />
					</div>
					<div>
						<label for="override-protein" class="form-label small">Protein g</label>
						<input id="override-protein" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="overrideFields.ProteinGrams" />
					</div>
					<div>
						<label for="override-carbs" class="form-label small">Carbs g</label>
						<input id="override-carbs" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="overrideFields.CarbsGrams" />
					</div>
					<div>
						<label for="override-fat" class="form-label small">Fat g</label>
						<input id="override-fat" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="overrideFields.FatGrams" />
					</div>
				</div>
			}

			@OverrideErrors()

			<div class="d-flex gap-2 mt-2">
				<button type="submit" class="btn btn-primary btn-sm" disabled="@overrideSaving">@(overrideSaving ? "Saving..." : "Save")</button>
				<button type="button" class="btn btn-link btn-sm" disabled="@overrideSaving" @onclick="CloseOverride">Cancel</button>
			</div>
		</form>;

	private RenderFragment OverrideErrors() =>
		@<text>
			@if (overrideErrors.Count > 0)
			{
				<div class="alert alert-danger mt-2 mb-0 py-2 small" role="alert">
					@foreach (var error in overrideErrors)
					{
						<div>@error</div>
					}
				</div>
			}
		</text>;

	private RenderFragment FormErrors() =>
		@<text>
			@if (formErrors.Count > 0)
			{
				<div class="alert alert-danger mt-2 mb-0 py-2 small" role="alert">
					@foreach (var error in formErrors)
					{
						<div>@error</div>
					}
				</div>
			}
		</text>;

	private enum ActionPanelKind
	{
		Actions,
		Edit,
		ConfirmClearNutrition,
		ConfirmDelete,
		Proposal,
		EditNutrition
	}
}
