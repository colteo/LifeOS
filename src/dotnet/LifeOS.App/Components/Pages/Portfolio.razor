@page "/portfolio"
@implements IDisposable
@inject PortfolioPrivacy Privacy
@inject AuthService Auth

@* The current financial position and the accounts behind it: totals per currency (never combined),
   then every account with its balance, managed here directly (add, ⋮ actions inline). Analytics is
   the page's contextual action. *@

<PageHeader Title="Portfolio">
	<Action>
		<a href="finance/analytics" class="lo-header-action">
			<AppIcon Name="chart" Size="18" />
			Analytics
		</a>
	</Action>
</PageHeader>

<section class="lo-section">
	<PortfolioCard Currencies="portfolio" IsLoading="isLoading" HasError="balancesError" OnRetry="RetryAsync" />
</section>

<section class="lo-section">
	@* The card above reports a balances failure; the rows then show "Balance unavailable". *@
	<AccountsManager @ref="accounts" HideAmounts="Privacy.IsHidden" ReportBalanceErrors="false" BalancesLoaded="OnBalancesLoaded" />
</section>

@code {
	private AccountsManager? accounts;
	private IReadOnlyList<CurrencyPortfolio>? portfolio;
	private bool balancesError;
	private bool isLoading = true;

	protected override void OnInitialized() => Privacy.Changed += OnPrivacyChanged;
	private void OnPrivacyChanged() => _ = InvokeAsync(StateHasChanged);
	public void Dispose() => Privacy.Changed -= OnPrivacyChanged;

	// The totals come from the balances the account list loaded (one request for both).
	private void OnBalancesLoaded(IReadOnlyList<AccountBalanceResponse>? balances)
	{
		balancesError = balances is null;
		portfolio = balances is null ? null : PortfolioSummary.Build(balances, Auth.CurrentUser?.DefaultCurrency);
		isLoading = false;
	}

	private async Task RetryAsync()
	{
		if (accounts is null)
		{
			return;
		}

		isLoading = true;
		await accounts.ReloadAsync();
	}
}
