@page "/gym"
@inject WorkoutSessionsApiClient SessionsApi

@* The Gym module: a workout in progress first (to resume it), then Train (the everyday action),
   History (completed workouts) and Programs (setting up what to train). *@

<PageHeader Title="Gym" BackHref="more" BackLabel="More" />

@if (current is not null)
{
	<WorkoutInProgressCard Session="current" />
}
else if (currentError is not null)
{
	<div class="alert alert-danger d-flex justify-content-between align-items-center gap-2" role="alert">
		<span>@currentError</span>
		<button class="btn btn-sm btn-outline-secondary" @onclick="LoadCurrentAsync">Retry</button>
	</div>
}

<div class="lo-card mb-3">
	<ul class="lo-list">
		<li>
			<a href="gym/train" class="lo-row lo-row--center lo-gym-train">
				<span class="lo-row__icon lo-gym-train__icon"><AppIcon Name="gym" /></span>
				<span class="lo-row__main">
					<span class="lo-row__title d-block lo-gym-train__title">Train</span>
					<span class="lo-row__sub d-block text-wrap">Your active program's workouts</span>
				</span>
				<span class="lo-row__chevron"><AppIcon Name="chevron-right" Size="18" /></span>
			</a>
		</li>
	</ul>
</div>

<div class="lo-card">
	<ul class="lo-list">
		<li>
			<a href="gym/history" class="lo-row lo-row--center">
				<span class="lo-row__icon"><AppIcon Name="history" /></span>
				<span class="lo-row__main">
					<span class="lo-row__title d-block">History</span>
					<span class="lo-row__sub d-block text-wrap">Completed workouts and what you lifted</span>
				</span>
				<span class="lo-row__chevron"><AppIcon Name="chevron-right" Size="18" /></span>
			</a>
		</li>
		<li>
			<a href="gym/programs" class="lo-row lo-row--center">
				<span class="lo-row__icon"><AppIcon Name="grid" /></span>
				<span class="lo-row__main">
					<span class="lo-row__title d-block">Programs</span>
					<span class="lo-row__sub d-block text-wrap">Create and edit workout programs</span>
				</span>
				<span class="lo-row__chevron"><AppIcon Name="chevron-right" Size="18" /></span>
			</a>
		</li>
	</ul>
</div>

@code {
	private WorkoutSessionResponse? current;
	private string? currentError;

	protected override Task OnInitializedAsync() => LoadCurrentAsync();

	private async Task LoadCurrentAsync()
	{
		var result = await SessionsApi.GetCurrentAsync();

		current = result.IsSuccess ? result.Value : null;
		currentError = result.IsSuccess ? null : string.Join(" ", result.Errors);
	}
}
