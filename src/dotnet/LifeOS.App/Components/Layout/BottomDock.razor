@implements IDisposable
@inject NavigationManager Navigation

@* The LifeOS modules, not the sitemap: Home, Finance, Gym and More (the module directory), with the
   central New transaction action. Everything else is reached from a module or through More. *@

<nav class="lo-dock" aria-label="Main">
	<div class="lo-dock__bar">
		@foreach (var item in Items)
		{
			if (item.IsPrimary)
			{
				<a href="@item.Href" class="lo-dock__primary" aria-label="@item.Label">
					<AppIcon Name="@item.Icon" Size="26" StrokeWidth="2.2" />
				</a>
			}
			else
			{
				var active = item.Section == activeSection;

				<a href="@item.Href" class="lo-dock__item @(active ? "active" : null)" aria-current="@(active ? "page" : null)">
					<AppIcon Name="@item.Icon" />
					<span class="lo-dock__label">@item.Label</span>
				</a>
			}
		}
	</div>
</nav>

@code {
	// Active rules live in DockNavigation. The primary item is an action with no section, so it can
	// later become a multi-module action sheet without changing the active rules.
	private static readonly DockItem[] Items =
	[
		new("Home", "home", DockNavigation.HomeHref, DockSection.Home),
		new("Finance", "finance", DockNavigation.FinanceHref, DockSection.Finance),
		new("New transaction", "plus", DockNavigation.NewTransactionHref, DockSection.None, IsPrimary: true),
		new("Gym", "gym", DockNavigation.GymHref, DockSection.Gym),
		new("More", "grid", DockNavigation.MoreHref, DockSection.More)
	];

	private DockSection activeSection;

	protected override void OnInitialized()
	{
		activeSection = SectionOf(Navigation.Uri);
		Navigation.LocationChanged += OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
	{
		activeSection = SectionOf(args.Location);
		InvokeAsync(StateHasChanged);
	}

	private DockSection SectionOf(string uri) =>
		DockNavigation.ActiveSection(DockNavigation.Normalize(Navigation.ToBaseRelativePath(uri)));

	public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

	private sealed record DockItem(string Label, string Icon, string Href, DockSection Section, bool IsPrimary = false);
}
