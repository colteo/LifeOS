@using LifeOS.App.Services.Navigation
@implements IDisposable
@inject NavigationManager Navigation

@* Transactions | + | More (APP-001). Items and active rules live in DockNavigation. *@

<nav class="lo-dock" aria-label="Main">
	<div class="lo-dock__bar">
		@foreach (var item in DockNavigation.Items)
		{
			var active = item.IsActive(currentPath);

			if (item.IsPrimary)
			{
				<a href="@item.Href" class="lo-dock__primary" aria-label="@item.Label">
					<AppIcon Name="@item.Icon" Size="26" StrokeWidth="2.2" />
				</a>
			}
			else
			{
				<a href="@item.Href" class="lo-dock__item @(active ? "active" : null)" aria-current="@(active ? "page" : null)">
					<AppIcon Name="@item.Icon" />
					<span>@item.Label</span>
				</a>
			}
		}
	</div>
</nav>

@code {
	private string currentPath = string.Empty;

	protected override void OnInitialized()
	{
		currentPath = PathOf(Navigation.Uri);
		Navigation.LocationChanged += OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
	{
		currentPath = PathOf(args.Location);
		InvokeAsync(StateHasChanged);
	}

	private string PathOf(string uri) => DockNavigation.Normalize(Navigation.ToBaseRelativePath(uri));

	public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
