@inherits LayoutComponentBase

@* The signed-in LifeOS shell: header, one centered content column, and the dock. AuthGate renders
   sign-in, session restore and onboarding outside of it, so those screens never show the shell. *@

<div class="lo-shell">
	<AppHeader />

	<main class="lo-main">
		<div class="lo-content">
			@Body
		</div>
	</main>

	<BottomDock />
</div>
