@using System.Globalization

@* The current financial position: one row per currency the user holds accounts in. Currencies are
   never added together, and an unavailable balance is never shown as zero. With Href, the card
   opens that page (Home → Portfolio). *@

@if (Currencies is { Count: > 0 } && Href is not null)
{
	<a href="@Href" class="lo-card lo-card--dark lo-portfolio d-block" aria-label="Portfolio, open details">
		@Content
	</a>
}
else
{
	<div class="lo-card lo-card--dark lo-portfolio">
		@Content
	</div>
}

@code {
	// Null until loaded.
	[Parameter]
	public IReadOnlyList<CurrencyPortfolio>? Currencies { get; set; }

	[Parameter]
	public bool IsLoading { get; set; }

	[Parameter]
	public bool HasError { get; set; }

	[Parameter]
	public EventCallback OnRetry { get; set; }

	[Parameter]
	public string? Href { get; set; }

	private RenderFragment Content =>
		@<text>
			<div class="lo-portfolio__header">
				<span>Portfolio</span>
				@if (Currencies is { Count: > 0 } && Href is not null)
				{
					<AppIcon Name="chevron-right" Size="18" />
				}
			</div>

			@if (HasError)
			{
				<div class="lo-portfolio__message">
					<span>Unable to load portfolio.</span>
					<button type="button" class="btn btn-sm btn-light" @onclick="OnRetry" disabled="@IsLoading">Retry</button>
				</div>
			}
			else if (Currencies is null)
			{
				<p class="lo-portfolio__message mb-0">Loading...</p>
			}
			else if (Currencies.Count == 0)
			{
				<p class="lo-portfolio__message mb-0">No accounts available.</p>
			}
			else
			{
				@foreach (var currency in Currencies)
				{
					<div class="lo-portfolio__row">
						<div class="d-flex justify-content-between align-items-baseline gap-3">
							<span class="lo-portfolio__currency">@currency.Currency</span>
							@if (currency.Status == PortfolioStatus.Unavailable)
							{
								<span class="lo-portfolio__note">Balance unavailable</span>
							}
							else
							{
								<span class="lo-portfolio__amount lo-amount">@FormatAmount(currency.KnownTotal)</span>
							}
						</div>
						<div class="lo-portfolio__note">@Caption(currency)</div>
					</div>
				}
			}
		</text>;

	// "2 accounts", or the partial state: "Partial · 1 balance unavailable".
	private static string Caption(CurrencyPortfolio currency) => currency.Status switch
	{
		PortfolioStatus.Partial => $"Partial · {UnavailableLabel(currency.UnavailableCount)}",
		_ => currency.AccountCount == 1 ? "1 account" : $"{currency.AccountCount} accounts"
	};

	private static string UnavailableLabel(int count) =>
		count == 1 ? "1 balance unavailable" : $"{count} balances unavailable";

	// Culture-aware, 2 to 4 decimals, signed net amount (a credit-card debt reduces its currency).
	private static string FormatAmount(decimal amount) =>
		amount.ToString("#,##0.00##", CultureInfo.CurrentCulture);
}
