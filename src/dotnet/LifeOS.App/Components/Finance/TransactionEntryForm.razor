@using System.Globalization
@inject AccountsApiClient AccountsApi
@inject CategoriesApiClient CategoriesApi
@inject TransactionsApiClient TransactionsApi

@* Quick transaction entry: Expense, Income or Transfer. The fields and their checks are shared with
   edit (TransactionFields, TransactionDraft). After a save the page stays here for the next entry. *@

@if (isLoading)
{
    <p class="lo-muted"><em>Loading accounts and categories...</em></p>
}
else if (loadErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in loadErrors)
        {
            <div>@error</div>
        }
    </div>
    <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync">Retry</button>
}
else if (accounts.Count == 0)
{
    <div class="lo-card lo-card--padded">
        <p class="mb-0">You need an account before recording transactions. <a href="finance/accounts" class="fw-semibold">Add an account</a>.</p>
    </div>
}
else
{
    @* Compact vertical rhythm: the whole form, Save included, should fit a phone screen with the
       keyboard closed. Order is fixed: type, amount, account(s), category, date and time, note, Save. *@
    <div class="lo-segmented lo-entry-type" role="group" aria-label="Transaction type">
        @foreach (var type in TransactionTypes)
        {
            <button type="button"
                    class="lo-segmented__option"
                    aria-pressed="@(type == draft.Type ? "true" : "false")"
                    @onclick="() => SelectType(type)">
                @type
            </button>
        }
    </div>

    <EditForm Model="draft" OnSubmit="SaveAsync">
        <TransactionFields Draft="draft" Accounts="accounts" Categories="categories"
                           OnChanged="ClearSuccess" OnSourceChanged="PreselectSingleAccount" />

        @if (saveErrors.Count > 0)
        {
            <div class="alert alert-danger lo-entry-message" role="alert">
                <ul class="mb-0">
                    @foreach (var error in saveErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        @if (successMessage is not null)
        {
            <div class="alert alert-success lo-entry-message d-flex justify-content-between align-items-center gap-2" role="status">
                <span>@successMessage</span>
                <a href="finance/transactions" class="fw-semibold text-nowrap">View transactions</a>
            </div>
        }

        <button type="submit" class="btn btn-primary w-100 lo-entry-save" disabled="@(isSaving || draft.HasCurrencyMismatch(accounts))">
            @(isSaving ? "Saving..." : $"Save {draft.Type.ToLowerInvariant()}")
        </button>
    </EditForm>
}

@code {
    // External transaction type names, as used by the API contract.
    private static readonly string[] TransactionTypes = [TransactionDraft.Expense, TransactionDraft.Income, TransactionDraft.Transfer];

    private IReadOnlyList<AccountResponse> accounts = [];
    private IReadOnlyList<CategoryResponse> categories = [];
    private bool isLoading = true;
    private IReadOnlyList<string> loadErrors = [];

    private readonly TransactionDraft draft = TransactionDraft.ForNew(TransactionDraft.Expense, DateTime.Now);
    private bool isSaving;
    private IReadOnlyList<string> saveErrors = [];
    private string? successMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadErrors = [];

        var accountsTask = AccountsApi.GetAccountsAsync();
        var categoriesTask = CategoriesApi.GetCategoriesAsync();
        await Task.WhenAll(accountsTask, categoriesTask);

        var accountsResult = accountsTask.Result;
        var categoriesResult = categoriesTask.Result;

        if (accountsResult.IsSuccess && categoriesResult.IsSuccess)
        {
            accounts = accountsResult.Value!;
            categories = categoriesResult.Value!;
            PreselectSingleAccount();
        }
        else
        {
            // Both clients report the same message when the API is unreachable; show it once.
            loadErrors = accountsResult.Errors.Concat(categoriesResult.Errors).Distinct().ToList();
        }

        isLoading = false;
    }

    private void SelectType(string type)
    {
        if (type == draft.Type)
        {
            return;
        }

        draft.ChangeType(type);
        PreselectSingleAccount();
        saveErrors = [];
        ClearSuccess();
    }

    // UI-only convenience: when exactly one account can be chosen for an empty field, choose it.
    // Income/Expense: the user's only account. Transfer: the only destination left once a source
    // is chosen (the source itself is never preselected, and source ≠ destination still holds).
    private void PreselectSingleAccount()
    {
        if (draft.IsTransfer)
        {
            if (draft.FindAccount(accounts, draft.SourceAccountId) is not null && draft.DestinationAccountId.Length == 0)
            {
                var destinations = accounts.Where(account => account.Id.ToString() != draft.SourceAccountId).ToList();

                if (destinations.Count == 1)
                {
                    draft.DestinationAccountId = destinations[0].Id.ToString();
                }
            }
        }
        else if (accounts.Count == 1 && draft.AccountId.Length == 0)
        {
            draft.AccountId = accounts[0].Id.ToString();
        }
    }

    private void ClearSuccess() => successMessage = null;

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return;
        }

        successMessage = null;
        saveErrors = [];

        if (!draft.TryBuild(TimeZoneInfo.Local, out var values, out var errors))
        {
            saveErrors = errors;
            return;
        }

        isSaving = true;

        var result = await TransactionsApi.CreateTransactionAsync(draft.ToCreateRequest(values));

        if (result.IsSuccess)
        {
            var transaction = result.Value!;
            successMessage = $"{transaction.Type} of {transaction.Amount.ToString("0.00##", CultureInfo.CurrentCulture)} {transaction.Currency} saved.";

            // Keep type and account selection(s) for fast repeated entry; reset the rest.
            draft.ClearForNextEntry(DateTime.Now);
        }
        else
        {
            saveErrors = result.Errors;
        }

        isSaving = false;
    }
}
