@using System.Globalization
@using LifeOS.Contracts.Finance.Budgets
@inject BudgetsApiClient BudgetsApi

@* The monthly budget (FIN-001) inside Home's Finance card (NAV-001): the card itself, with "Monthly
   budget" as one Finance concern under the section's Finance heading. Free to spend leads; spent of
   budget, expected and safe/day follow. Values come from the budget API as they are; nothing is
   computed here. Set / Edit / Remove are unchanged. *@

<div class="lo-card p-3">
    <div class="lo-budget-header">
        <h3 class="lo-budget-title">Monthly budget</h3>
        @if (budget is not null && !editing)
        {
            <button type="button" class="lo-header-action" aria-label="Edit monthly budget" @onclick="Edit">Edit</button>
        }
    </div>
    @if (error is not null)
    {
        <div class="text-danger mb-2" role="alert">@error</div>
    }
    @if (loading)
    {
        <p class="lo-muted mb-0">Loading budget...</p>
    }
    else if (!loaded)
    {
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">Retry</button>
    }
    else if (editing)
    {
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <label class="form-label" for="monthly-budget-amount">@LocalMonth.Label(month) budget (@Currency)</label>
            <input id="monthly-budget-amount" class="form-control" inputmode="decimal" @bind="amountText" disabled="@saving" />
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary btn-sm" type="submit" disabled="@saving">Save</button>
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="Cancel" disabled="@saving">Cancel</button>
                @if (budget is not null)
                {
                    <button class="btn btn-outline-danger btn-sm ms-auto" type="button" @onclick="() => confirmingRemoval = true" disabled="@saving">Remove</button>
                }
            </div>
        </form>
        @if (confirmingRemoval)
        {
            <div class="mt-3" role="alert">
                <p>Remove this month's budget?</p>
                <button class="btn btn-danger btn-sm" @onclick="RemoveAsync" disabled="@saving">Remove budget</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmingRemoval = false" disabled="@saving">Keep budget</button>
            </div>
        }
    }
    else if (budget is null)
    {
        <div class="d-flex justify-content-between align-items-center gap-2">
            <span class="lo-muted">No @LocalMonth.Label(month) budget.</span>
            <button class="btn btn-sm btn-outline-primary" @onclick="Edit">Set budget</button>
        </div>
    }
    else
    {
        <div class="lo-muted small">@LocalMonth.Label(month) · @budget.Currency</div>
        <div class="lo-budget-free">
            <div class="lo-budget-free__amount @(budget.FreeToSpend < 0 ? "text-danger" : null)">@Money(budget.FreeToSpend)</div>
            <div class="lo-muted">free to spend</div>
        </div>
        <div class="lo-budget-progress" role="progressbar" aria-label="Budget spent" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="@Progress.ToString(CultureInfo.InvariantCulture)">
            <span class="lo-budget-progress__bar @(budget.Remaining < 0 ? "bg-danger" : "")" style="width: @(Progress.ToString(CultureInfo.InvariantCulture))%"></span>
        </div>
        <div>@Money(budget.Spent) spent of @Money(budget.Amount)</div>
        @if (budget.Remaining < 0)
        {
            <div class="text-danger">@Money(budget.Remaining) remaining · Budget exceeded</div>
        }
        <div class="lo-muted">@Money(budget.ExpectedExpensesTotal) expected</div>
        @if (budget.SafeDailySpend is { } safe)
        {
            <div><strong>@Money(safe)/day</strong> <span class="lo-muted">safe to spend</span></div>
        }
    }
    @if (Actions is not null)
    {
        <div class="lo-budget-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string? Currency { get; set; }
    // Navigation shown at the bottom of the card in every state (loading, error, editing included).
    [Parameter] public RenderFragment? Actions { get; set; }
    private DateTime month;
    private MonthlyBudgetResponse? budget;
    private string? error;
    private string amountText = "";
    private bool loading = true, loaded, editing, saving, confirmingRemoval;
    private string? loadedCurrency;
    private decimal Progress => budget is null ? 0 : Math.Clamp(budget.Spent / budget.Amount * 100m, 0m, 100m);
    private string Money(decimal amount) => AnalyticsDisplay.Amount(amount, Currency!);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCurrency != Currency || !loaded)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        loaded = false;
        error = null;
        month = LocalMonth.Containing(DateTime.Today);
        loadedCurrency = Currency;
        if (string.IsNullOrWhiteSpace(Currency))
        {
            error = "A default currency is required to configure a budget.";
            loading = false;
            return;
        }
        var result = await BudgetsApi.GetAsync(month, Currency);
        loading = false;
        loaded = result.IsSuccess;
        budget = result.IsSuccess ? result.Value!.Budget : null;
        error = result.IsSuccess ? null : string.Join(" ", result.Errors);
    }

    private void Edit()
    {
        amountText = budget?.Amount.ToString("0.####", CultureInfo.InvariantCulture) ?? "";
        error = null;
        editing = true;
    }
    private void Cancel() { editing = false; confirmingRemoval = false; error = null; }

    private async Task SaveAsync()
    {
        if (saving) return;
        if (!DecimalText.TryParse(amountText, false, out var amount) || amount <= 0)
        {
            error = "Enter a budget amount greater than zero.";
            return;
        }
        saving = true;
        var result = await BudgetsApi.SetAsync(month, Currency!, amount);
        saving = false;
        if (!result.IsSuccess) { error = string.Join(" ", result.Errors); return; }
        Cancel();
        await LoadAsync();
    }

    private async Task RemoveAsync()
    {
        if (saving) return;
        saving = true;
        var result = await BudgetsApi.DeleteAsync(month, Currency!);
        saving = false;
        if (!result.IsSuccess) { error = string.Join(" ", result.Errors); return; }
        Cancel();
        await LoadAsync();
    }
}
