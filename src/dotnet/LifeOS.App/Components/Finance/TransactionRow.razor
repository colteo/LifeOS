@* One transaction in a list (Home, Transactions): the note or category, then where the money moved,
   then when; the signed amount on the right (expense red, income green, transfer neutral). With Href
   the whole row is one link (to the transaction's detail). *@

@if (Href is not null)
{
	<li>
		<a href="@Href" class="lo-row">@Content</a>
	</li>
}
else
{
	<li class="lo-row">@Content</li>
}

@code {
	[Parameter, EditorRequired]
	public TransactionResponse Transaction { get; set; } = default!;

	[Parameter, EditorRequired]
	public IReadOnlyList<AccountResponse> Accounts { get; set; } = default!;

	[Parameter, EditorRequired]
	public IReadOnlyList<CategoryResponse> Categories { get; set; } = default!;

	// The third line: "Today 18:05" on Home, the time of day under a day heading on Transactions.
	[Parameter, EditorRequired]
	public string When { get; set; } = default!;

	[Parameter]
	public string? Href { get; set; }

	private RenderFragment Content =>
		@<text>
			<span class="lo-row__main">
				<span class="lo-row__title d-block">@TransactionDisplay.Title(Transaction, Categories)</span>
				<span class="lo-row__sub d-block">@TransactionDisplay.Details(Transaction, Accounts, Categories)</span>
				<span class="lo-row__sub d-block">@When</span>
			</span>
			<span class="lo-row__end lo-amount @TransactionDisplay.AmountCssClass(Transaction)">@TransactionDisplay.AmountText(Transaction)</span>
		</text>;
}
