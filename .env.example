POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change_me

# Python AI service (src/python/lifeos-ai, NUT-002). It reads these from the process
# environment of its own terminal; Docker Compose ignores them. Never commit a real key.
# GROQ_API_KEY=
# LIFEOS_AI_NUTRITION_MODEL=openai/gpt-oss-20b
# AI-004 journal memory (not activated yet; see docs/tasks/ai/AI-004.md). Journal text is sent to OpenAI
# for embeddings when this key is set.
# OPENAI_API_KEY=
# LIFEOS_AI_JOURNAL_EMBEDDING_MODEL=text-embedding-3-small
# LIFEOS_AI_JOURNAL_ANSWER_MODEL=openai/gpt-oss-20b
