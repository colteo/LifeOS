POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change_me

# Python AI service (src/python/lifeos-ai, NUT-002). It reads these from the process
# environment of its own terminal; Docker Compose ignores them. Never commit a real key.
# GROQ_API_KEY=
# LIFEOS_AI_NUTRITION_MODEL=openai/gpt-oss-20b
# Journal memory (AI-004, promoted to OpenAI by docs/tasks/ai/AI-006.1.md). Journal text and questions
# are sent to OpenAI (embeddings; Responses with store=false) when this key is set. With the default
# providers no other key configures Journal Memory.
# OPENAI_API_KEY=
# Rollback/testing only (one provider per capability, no fallback): google / groq.
# LIFEOS_AI_JOURNAL_EMBEDDING_PROVIDER=openai
# LIFEOS_AI_JOURNAL_ANSWER_PROVIDER=openai
# GEMINI_API_KEY=
