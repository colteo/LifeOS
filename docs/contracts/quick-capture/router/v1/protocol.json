{
  "protocol": "quick-capture.router",
  "protocol_version": 1,
  "output_version": 1,
  "status": "proposed",
  "locale": "it-IT",
  "endpoint": "POST /v1/quick-capture/route",
  "limits": {
    "message_length": 1000,
    "max_segments": 5,
    "span_length": 1000,
    "context_spans_per_segment": 3,
    "context_span_length": 200,
    "reference_span_length": 200,
    "max_open_drafts": 10
  },
  "configurable": {
    "max_segments": {
      "setting": "Assistant:QuickCapture:MaxSegmentsPerMessage",
      "min": 1,
      "max": 5,
      "default": 5
    },
    "max_open_drafts": {
      "setting": "Assistant:QuickCapture:MaxOpenDraftsPerConversation",
      "min": 1,
      "max": 10,
      "default": 10
    }
  },
  "errors": [
    {
      "status": 401,
      "code": "unauthorized",
      "failure": "unavailable"
    },
    {
      "status": 422,
      "code": "invalid_request",
      "failure": "invalid_output"
    },
    {
      "status": 500,
      "code": "internal_error",
      "failure": "unavailable"
    },
    {
      "status": 502,
      "code": "interpretation_failed",
      "failure": "invalid_output"
    },
    {
      "status": 502,
      "code": "interpretation_refused",
      "failure": "refused"
    },
    {
      "status": 503,
      "code": "provider_unavailable",
      "failure": "unavailable"
    }
  ]
}
