{
  "protocol": "quick-capture.hydration",
  "protocol_version": 1,
  "output_version": 1,
  "status": "proposed",
  "locale": "it-IT",
  "endpoint": "POST /v1/quick-capture/hydration/interpret",
  "kind": "hydration.intake.create",
  "reuses": {
    "contract": "assistant-interpretation/v2",
    "section": "hydration"
  },
  "limits": {
    "segment_length": 1000,
    "context_spans": 3,
    "context_span_length": 200,
    "value_length": 200,
    "note_length": 1000,
    "span_length": 1000,
    "days_ago": 366
  },
  "errors": [
    {
      "status": 401,
      "code": "unauthorized",
      "failure": "unavailable"
    },
    {
      "status": 422,
      "code": "invalid_request",
      "failure": "invalid_output"
    },
    {
      "status": 500,
      "code": "internal_error",
      "failure": "unavailable"
    },
    {
      "status": 502,
      "code": "interpretation_failed",
      "failure": "invalid_output"
    },
    {
      "status": 502,
      "code": "interpretation_refused",
      "failure": "refused"
    },
    {
      "status": 503,
      "code": "provider_unavailable",
      "failure": "unavailable"
    }
  ]
}
