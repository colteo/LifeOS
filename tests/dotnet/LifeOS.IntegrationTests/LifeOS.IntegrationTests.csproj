<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\dotnet\LifeOS.Api\LifeOS.Api.csproj" />
  </ItemGroup>

  <!-- In-memory repositories shared with LifeOS.UnitTests, until PostgreSQL-backed tests are added. -->
  <ItemGroup>
    <Compile Include="..\LifeOS.UnitTests\Fakes\FixedTimeProvider.cs" Link="Fakes\FixedTimeProvider.cs" />
    <Compile Include="..\LifeOS.UnitTests\Fakes\InMemoryAccountRepository.cs" Link="Fakes\InMemoryAccountRepository.cs" />
    <Compile Include="..\LifeOS.UnitTests\Fakes\InMemoryCategoryRepository.cs" Link="Fakes\InMemoryCategoryRepository.cs" />
    <Compile Include="..\LifeOS.UnitTests\Fakes\InMemoryTransactionRepository.cs" Link="Fakes\InMemoryTransactionRepository.cs" />
    <Compile Include="..\LifeOS.UnitTests\Fakes\InMemoryUserRepository.cs" Link="Fakes\InMemoryUserRepository.cs" />
    <Compile Include="..\LifeOS.UnitTests\Fakes\InMemoryUserSessionRepository.cs" Link="Fakes\InMemoryUserSessionRepository.cs" />
  </ItemGroup>

</Project>
